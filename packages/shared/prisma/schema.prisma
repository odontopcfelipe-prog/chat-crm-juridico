generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id   String @id @default(uuid())
  name String

  // Onda 17.32.77 — Multi-tenant SaaS Fase 1.
  // Identificacao publica e branding (white-label).
  slug             String?   @unique // ex: "clinica-passos" -> /t/clinica-passos
  cpf_cnpj         String? // pra cobranca da mensalidade
  phone            String?
  email            String? // contato principal
  logo_url         String? // exibido em login + sidebar + PDFs
  theme_color      String? // hex ex: "#3B82F6"
  custom_domain    String?   @unique // ex: "sistema.clinicapassos.com.br"
  // Onda 17.32.154 — Endereco da clinica (aparece em recibos, contratos, NFs)
  zip_code           String?
  address            String?
  address_number     String?
  address_complement String?
  neighborhood       String?
  city               String?
  state              String?  @db.VarChar(2)
  // Onda 17.32.154 — Responsavel tecnico (dentista CRO da clinica)
  responsible_name   String?
  responsible_cro    String?  // ex: "12345-SP"
  // Onda 17.32.154 — Horario de funcionamento (texto livre por simplicidade)
  // ex: "Seg-Sex 08:00-18:00, Sab 08:00-12:00"
  business_hours     String?
  /// Usuario "dono" (responsavel financeiro do tenant). Quando suspende, ele eh
  /// avisado. Nao bloqueia delete do User — owner_user_id vira null.
  owner_user_id    String?
  // Status do tenant — gate de login + filtros admin
  /// ACTIVE | TRIAL | SUSPENDED | DELETED
  status           String    @default("ACTIVE")
  /// Plano contratado — STARTER | PRO | ENTERPRISE | CUSTOM
  plan             String    @default("STARTER")
  trial_ends_at    DateTime? // quando TRIAL expira (fica SUSPENDED)
  suspended_at     DateTime?
  suspended_reason String?
  /// Onda 17.32.123 — Estado do onboarding (wizard de primeira vez).
  /// Estrutura JSON livre, esquema esperado:
  ///   {
  ///     "whatsapp":      "done" | "pending",
  ///     "asaas":         "done" | "pending",
  ///     "first_patient": "done" | "skipped" | "pending",
  ///     "team":          "done" | "skipped" | "pending",
  ///     "dismissed_at":  ISO timestamp (user fechou wizard sem terminar),
  ///     "completed_at":  ISO timestamp (user concluiu o wizard)
  ///   }
  /// Quando completed_at preenchido, wizard nao reaparece automaticamente.
  onboarding_state Json      @default("{}")
  // Onda 17.32.87 — @default(now()) + @updatedAt evita NOT NULL error
  // em prisma db push quando ja ha linhas existentes na tabela
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  conversations               Conversation[]
  leads                       Lead[]
  tasks                       Task[]
  users                       User[]
  inboxes                     Inbox[]
  instances                   Instance[]
  calendar_events             CalendarEvent[]
  appointment_types           AppointmentType[]
  holidays                    Holiday[]
  schedule_blocks             ScheduleBlock[]
  ai_chats                    AiChat[]
  pipelines                   Pipeline[]
  followup_sequences          FollowupSequence[]
  financial_transactions      FinancialTransaction[]
  financial_categories        FinancialCategory[]
  payment_gateway_customers   PaymentGatewayCustomer[]
  payment_gateway_charges     PaymentGatewayCharge[]
  notas_fiscais               NotaFiscal[]
  broadcast_jobs              BroadcastJob[]
  lead_honorarios             LeadHonorario[]
  notifications               Notification[]
  memories                    Memory[]
  lead_profiles               LeadProfile[]
  organization_profile        OrganizationProfile?
  // Odontologia (Fase 2)
  patients                    Patient[]
  specialties                 Specialty[]
  procedures                  Procedure[]
  anamnesis_templates         AnamnesisTemplate[]
  // Onda 3.2 — sugestoes de procedimento por estado clinico
  state_procedure_suggestions StateProcedureSuggestion[]
  // Estetica facial + estoque (Fase 6)
  suppliers                   Supplier[]
  products                    Product[]
  stock_movements             StockMovement[]
  esthetic_applications       EstheticApplication[]
  adverse_reactions           AdverseReaction[]
  // Onda 5 (Fase 25) — manutencoes/recall
  maintenance_tasks           MaintenanceTask[]
  // Agenda evoluida (Fase 7)
  rooms                       Room[]
  appointment_markers         AppointmentMarker[]
  return_alerts               ReturnAlert[]
  // Comissoes + metas (Fase 8)
  commission_rules            CommissionRule[]
  commissions                 Commission[]
  goals                       Goal[]
  // Regua de cobranca (Fase 11)
  installments                Installment[]
  // Portal do paciente (Fase 13)
  portal_tokens               PortalToken[]
  // Multi-unidade (Fase 15)
  clinics                     Clinic[]
  // Smile/Face Design (Fase 16)
  smile_simulations           SmileSimulation[]
  // Radiologia (Fase 17)
  radiography_providers       RadiographyProvider[]
  radiography_exams           RadiographyExam[]
  // Tags / segmentacao (Fase 20)
  patient_tags                PatientTag[]
  // Indicacao premiada (Fase 21)
  referrals                   Referral[]
  referral_rule               ReferralRule?
  // Onda 2 orcamentos (Fase 24)
  quote_templates             QuoteTemplate[]
  quote_coupons               QuoteCoupon[]
  // Pos-atendimento (Fase 26)
  post_care_surveys           PostCareSurvey[]
  // Marketing — Influenciadores
  influencers                 Influencer[]
  influencer_msg_templates    InfluencerMessageTemplate[]
  influencer_schedules        InfluencerSchedule[]
  influencer_message_logs     InfluencerMessageLog[]
  // Programa de Afiliado (Onda 5e v34, Fase 25)
  affiliate_referrals         AffiliateReferral[]
  affiliate_withdrawals       AffiliateWithdrawal[]
  // E-mails automaticos (Onda 17.32.181)
  email_templates             TenantEmailTemplate[]
}

/// Onda 17.32.181 — E-mails automaticos por tenant (estilo Nuvemshop).
/// Os defaults (assunto/corpo/variaveis) vivem no codigo
/// (apps/api/src/email-automation/email-events.ts); uma linha aqui
/// representa o OVERRIDE do tenant pra um evento. Sem linha = padrao.
model TenantEmailTemplate {
  id         String   @id @default(uuid())
  tenant_id  String
  /// 'cobranca_criada' | 'pagamento_confirmado' | 'agendamento_criado'
  event_key  String
  enabled    Boolean  @default(true)
  subject    String
  /// Texto com {{variaveis}}; quebras de linha viram <br> no envio
  body       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, event_key])
}

model User {
  id                            String                 @id @default(uuid())
  tenant_id                     String?
  name                          String
  email                         String                 @unique
  phone                         String?
  password_hash                 String
  roles                         String[]               @default(["OPERADOR"])
  specialties                   String[]               @default([])
  // Onda 17.32.116 — Setores e permissoes (Fase 2)
  /// Setor do usuario: 'recepcao' | 'dentista' | 'acd_asb' | 'crc' | 'financeiro' | 'admin'
  /// Determina home/sidebar default + pacote de permissoes.
  /// Backfill automatico no boot da API derivando de roles[].
  sector                        String?
  /// Permissoes extras alem do pacote default do setor.
  /// Lista de Permission ('view_financial' | 'manage_users' | ...).
  extra_grants                  String[]               @default([])
  /// Permissoes que foram REMOVIDAS do pacote default do setor.
  extra_revokes                 String[]               @default([])
  cro_number                    String? // Número CRO (Conselho Regional de Odontologia), ex: "CRO-AL 12345"
  cro_uf                        String? // UF do CRO (ex: "AL")
  // Onda 17.67 — Remuneração do profissional (cadastro). Todos opcionais; comissão é opcional.
  /// Comissão de VENDA (quem fecha a venda): tipo 'PERCENT' | 'FIXED' + valor (% ou R$).
  commission_sale_type          String?
  commission_sale_value         Decimal?               @db.Decimal(10, 2)
  /// Comissão de EXECUÇÃO (quem realiza): padrão do profissional. Override por procedimento via CommissionRule.
  commission_exec_type          String?
  commission_exec_value         Decimal?               @db.Decimal(10, 2)
  /// Diária (valor cheio; meia-diária = metade). Lançada por admin/financeiro — NUNCA pelo dentista.
  daily_rate                    Decimal?               @db.Decimal(10, 2)
  profile_picture_url           String? // Path relativo no filesystem (profiles/{id}.ext)
  // Onda 17.32.172 — confirmacao de e-mail dos membros da equipe.
  // Token enviado por e-mail no cadastro; verified_at marca quando o
  // membro clicou no link. NAO bloqueia login (usuarios legados nunca
  // confirmaram) — serve como validacao do endereco + badge na equipe.
  email_verified_at             DateTime?
  email_verify_token            String?                @unique
  email_verify_sent_at          DateTime?
  // Onda 17.32.179 — redefinicao de senha por e-mail (expira em 1h)
  password_reset_token          String?                @unique
  password_reset_sent_at        DateTime?
  created_at                    DateTime               @default(now())
  updated_at                    DateTime               @updatedAt
  audit_logs                    AuditLog[]
  assigned_convos               Conversation[]         @relation("AssignedUser")
  dentist_convos                Conversation[]         @relation("AssignedDentist")
  lead_notes                    LeadNote[]
  stage_history_actor           LeadStageHistory[]     @relation("StageHistoryActor")
  inboxes                       Inbox[]
  tasks                         Task[]
  tenant                        Tenant?                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  task_comments                 TaskComment[]
  supervisors                   User[]                 @relation("InternSupervisors")
  interns                       User[]                 @relation("InternSupervisors")
  calendar_events_assigned      CalendarEvent[]        @relation("EventAssigned")
  calendar_events_created       CalendarEvent[]        @relation("EventCreator")
  calendar_events_validated     CalendarEvent[]        @relation("EventValidator")
  quote_attachments_uploaded    QuoteAttachment[]      @relation("QuoteAttachmentUploader")
  quote_versions_created        QuoteVersion[]         @relation("QuoteVersionCreator")
  schedules                     UserSchedule[]
  schedule_blocks_owned         ScheduleBlock[]        @relation("ScheduleBlockUser")
  schedule_blocks_created       ScheduleBlock[]        @relation("ScheduleBlockCreator")
  calendar_event_comments       CalendarEventComment[]
  transfer_audios               TransferAudio[]        @relation("AudioUploader")
  ai_chats                      AiChat[]               @relation("AiChatOwner")
  cs_leads                      Lead[]                 @relation("CSManager")
  financial_transactions        FinancialTransaction[] @relation("FinancialDentist")
  conversation_notes            ConversationNote[]     @relation("ConversationNoteAuthor")
  broadcast_jobs                BroadcastJob[]
  notification_setting          NotificationSetting?
  conversation_mutes            ConversationMute[]
  notifications                 Notification[]
  push_subscriptions            PushSubscription[]
  // Odontologia (Fase 2)
  specialties_rel               Specialty[]            @relation("UserSpecialties")
  primary_patients              Patient[]              @relation("PrimaryDentist")
  clinical_notes_authored       ClinicalNote[]         @relation("ClinicalNoteAuthor")
  quotes_created                Quote[]                @relation("QuoteCreator")
  quotes_deleted                Quote[]                @relation("QuoteDeleter")
  quotes_archived               Quote[]                @relation("QuoteArchiver")
  // Onda 14.24 — contratos criados e eventos de contrato disparados
  contracts_created             Contract[]             @relation("ContractCreator")
  contract_events_triggered     ContractEvent[]        @relation("ContractEventTrigger")
  treatment_plan_items_executed TreatmentPlanItem[]    @relation("TreatmentPlanItemExecutor")
  quote_items_assigned          QuoteItem[]            @relation("QuoteItemDentist")
  // Estetica facial + estoque (Fase 6)
  stock_movements_performed     StockMovement[]        @relation("StockMover")
  esthetic_applications_done    EstheticApplication[]  @relation("EstheticApplicator")
  adverse_reactions_reported    AdverseReaction[]      @relation("AdverseReactionReporter")
  // Onda 5 (Fase 25) — manutencoes/recall
  maintenance_tasks_completed   MaintenanceTask[]      @relation("MaintenanceTaskCompletedBy")
  maintenance_tasks_created     MaintenanceTask[]      @relation("MaintenanceTaskCreatedBy")
  // Agenda evoluida (Fase 7)
  return_alerts_owned           ReturnAlert[]          @relation("ReturnAlertProfessional")
  return_alerts_contacted       ReturnAlert[]          @relation("ReturnAlertContact")
  // Comissoes + metas (Fase 8)
  commission_rules              CommissionRule[]       @relation("CommissionRuleProfessional")
  commissions_received          Commission[]           @relation("CommissionRecipient")
  goals_assigned                Goal[]                 @relation("GoalProfessional")
  // Multi-unidade (Fase 15)
  user_clinics                  UserClinic[]
  // Smile/Face Design (Fase 16)
  smile_simulations_created     SmileSimulation[]      @relation("SmileSimulationCreator")
  // Radiologia (Fase 17)
  radiography_exams_linked      RadiographyExam[]      @relation("RadiographyLinker")
  // Lista de espera (Fase 19)
  waitlist_assigned             WaitlistEntry[]        @relation("WaitlistDentist")
  // Pos-atendimento (Fase 26)
  post_care_surveys_dentist     PostCareSurvey[]       @relation("PostCareSurveyDentist")
  // Programa de Afiliado (Onda 5e v34) — user que confirmou pagamento de saque
  affiliate_withdrawals_paid    AffiliateWithdrawal[]  @relation("AffiliateWithdrawalPaidBy")
}

model Lead {
  id                  String         @id @default(uuid())
  tenant_id           String?
  name                String?
  /// Onda 17.36 — phone era @unique GLOBAL: o mesmo numero so podia existir
  /// como lead em UMA clinica, e o upsert do webhook grudava a mensagem no
  /// lead de OUTRO tenant (vazamento). Agora a unicidade e por tenant.
  phone               String
  email               String?
  origin              String?
  // Pipeline dinâmico (Fase 1). `stage` String é legado — será deprecado
  // quando todos os leads tiverem stage_id populado. Enquanto isso,
  // ambos coexistem e o stage String é fonte de verdade para código legado.
  stage               String         @default("NOVO")
  stage_entered_at    DateTime       @default(now())
  pipeline_id         String?
  stage_id            String?
  pipeline            Pipeline?      @relation(fields: [pipeline_id], references: [id], onDelete: SetNull)
  current_stage       PipelineStage? @relation("CurrentStage", fields: [stage_id], references: [id], onDelete: SetNull)
  loss_reason         String?
  profile_picture_url String?
  tags                String[]
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  // ─── Separação Lead vs Cliente ────────────────────────────
  // Quando true: lead se tornou cliente (contrato assinado/FINALIZADO)
  is_client        Boolean   @default(false)
  became_client_at DateTime?
  // Operador que fechou a venda — mantém vínculo pós-conversão
  cs_user_id       String?
  cs_user          User?     @relation("CSManager", fields: [cs_user_id], references: [id], onDelete: SetNull)

  // Google Drive
  google_drive_folder_id String?

  memory                    AiMemory?
  profile                   LeadProfile?
  patient                   Patient?
  conversations             Conversation[]
  tenant                    Tenant?                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tasks                     Task[]
  calendar_events           CalendarEvent[]
  last_followup_at          DateTime?
  notes                     LeadNote[]
  stage_history             LeadStageHistory[]
  contract_signatures       ContractSignature[]
  followup_enrollments      FollowupEnrollment[]
  financial_transactions    FinancialTransaction[]
  payment_gateway_customers PaymentGatewayCustomer[]
  notas_fiscais             NotaFiscal[]
  waitlist_entries          WaitlistEntry[]
  broadcast_items           BroadcastItem[]
  lead_honorarios           LeadHonorario[]
  cpf_cnpj                  String? // CPF ou CNPJ — facilita match com Asaas

  // Unicidade POR TENANT (Postgres: tenant_id null nao colide — leads orfaos
  // legados convivem; o codigo resolve orfaos por escopo explicito).
  @@unique([tenant_id, phone])
  @@index([phone])
  @@index([stage])
  @@index([pipeline_id])
  @@index([stage_id])
  @@index([cpf_cnpj])
  @@index([is_client])
}

model Conversation {
  id                         String              @id @default(uuid())
  tenant_id                  String?
  lead_id                    String
  channel                    String              @default("whatsapp")
  external_id                String?
  status                     String              @default("ABERTO")
  ai_mode                    Boolean             @default(true)
  ai_mode_disabled_at        DateTime? // Timestamp de quando ai_mode foi desligado (para auto-reativação)
  ai_mode_source             String? // "MANUAL" | "CRON_AFTER_HOURS" | "POS_VENDA" | null — origem da última mudança em ai_mode (POS_VENDA = religou ao lead virar cliente, ver leads.service.ts)
  assigned_user_id           String?
  inbox_id                   String?
  instance_name              String? // Nome da instancia de origem (ex: wa1)
  pending_transfer_to_id     String?
  pending_transfer_from_id   String?
  pending_transfer_reason    String?
  pending_transfer_audio_ids String[]            @default([])
  specialty                  String? // Especialidade odontológica detectada pela IA (endodontia, ortodontia, periodontia, etc.)
  assigned_dentist_id        String? // Dentista pre-designado pela IA
  origin_assigned_user_id    String? // Quem transferiu (para devolucao)
  linked_agent_ids           String[]            @default([]) // Todos os agentes que atenderam
  next_step                  String? // Proximo passo: "duvidas" | "triagem_concluida" | "formulario" | "reuniao" | "encerrado"
  ai_notes                   String? // Observacoes internas da IA (campo notes do JSON)
  reminder_context           Json? // Contexto do ultimo lembrete WhatsApp enviado ao cliente (audiencia/prazo)
  last_message_at            DateTime            @default(now())
  assigned_user              User?               @relation("AssignedUser", fields: [assigned_user_id], references: [id], onDelete: SetNull)
  assigned_dentist           User?               @relation("AssignedDentist", fields: [assigned_dentist_id], references: [id], onDelete: SetNull)
  lead                       Lead                @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  tenant                     Tenant?             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  inbox                      Inbox?              @relation(fields: [inbox_id], references: [id], onDelete: SetNull)
  messages                   Message[]
  tasks                      Task[]
  calendar_events            CalendarEvent[]
  transfer_audios            TransferAudio[]
  contract_signatures        ContractSignature[]
  notes                      ConversationNote[]
  mutes                      ConversationMute[]

  @@index([lead_id])
  @@index([last_message_at(sort: Desc)])
  @@index([instance_name])
  @@index([tenant_id])
  @@index([assigned_user_id])
  @@index([status])
  @@index([pending_transfer_to_id])
  @@index([inbox_id])
}

model Message {
  id                  String            @id @default(uuid())
  conversation_id     String
  direction           String
  type                String
  text                String?
  external_message_id String?           @unique
  status              String
  created_at          DateTime          @default(now())
  reply_to_id         String?
  reply_to_text       String?
  skill_id            String? // Qual PromptSkill gerou esta resposta IA
  instance_name       String? // Model B: chip (Instance) que de fato recebeu/enviou esta msg. A conversa flutua entre chips (Comercial/Clinica), mas a msg fica fixa no chip de origem — usado pra retry de download de midia na instancia certa.
  media               Media?
  reactions           MessageReaction[]
  conversation        Conversation      @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  reply_to            Message?          @relation("MessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies             Message[]         @relation("MessageReplies")
  skill               PromptSkill?      @relation(fields: [skill_id], references: [id], onDelete: SetNull)
  tasks               Task[]

  @@index([conversation_id, created_at])
  @@index([external_message_id])
}

model MessageReaction {
  id          String   @id @default(uuid())
  message_id  String
  user_id     String?
  contact_jid String?
  emoji       String
  created_at  DateTime @default(now())
  message     Message  @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id])
  @@unique([message_id, contact_jid])
  @@index([message_id])
}

model Media {
  id            String   @id @default(uuid())
  message_id    String   @unique
  s3_key        String? /// DEPRECATED: path no MinIO (mídias antigas). Novo: usar file_path.
  file_path     String? /// Path relativo a MEDIA_STORAGE_PATH (ex: "2026/04/uuid.ogg")
  mime_type     String
  size          Int?
  duration      Int?
  checksum      String?
  original_url  String? /// URL temporária Evolution CDN (fallback, expira ~48h)
  original_name String?
  created_at    DateTime @default(now())
  message       Message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
}

model Task {
  id                String              @id @default(uuid())
  tenant_id         String?
  lead_id           String?
  conversation_id   String?
  message_id        String?
  calendar_event_id String?             @unique
  title             String
  description       String?
  due_at            DateTime?
  status            String              @default("A_FAZER")
  assigned_user_id  String?
  created_at        DateTime            @default(now())
  completion_note   String?
  postpone_count    Int                 @default(0)
  created_by_id     String?
  assigned_user     User?               @relation(fields: [assigned_user_id], references: [id], onDelete: SetNull)
  conversation      Conversation?       @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  lead              Lead?               @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  message           Message?            @relation(fields: [message_id], references: [id], onDelete: SetNull)
  tenant            Tenant?             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  calendar_event    CalendarEvent?      @relation(fields: [calendar_event_id], references: [id], onDelete: SetNull)
  comments          TaskComment[]
  checklist_items   TaskChecklistItem[]
  postponements     TaskPostponement[]

  @@index([assigned_user_id, due_at])
  @@index([status])
  @@index([tenant_id])
  @@index([lead_id])
}

model TaskPostponement {
  id            String   @id @default(uuid())
  task_id       String
  task          Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  old_due_at    DateTime
  new_due_at    DateTime
  reason        String
  created_by_id String?
  created_at    DateTime @default(now())

  @@index([task_id])
}

model AiMemory {
  id              String   @id @default(uuid())
  lead_id         String   @unique
  summary         String
  facts_json      Json     @default("{}")
  last_updated_at DateTime @default(now())
  version         Int      @default(1)
  lead            Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
}

model PromptSkill {
  id                 String       @id @default(uuid())
  name               String
  area               String
  system_prompt      String
  tools_policy_json  Json         @default("[]")
  version            Int          @default(1)
  active             Boolean      @default(true)
  model              String       @default("gpt-4o-mini")
  max_tokens         Int          @default(300)
  temperature        Float        @default(0.7)
  handoff_signal     String? // Palavra que a IA usa para sinalizar escalada ao humano (ex: "ESCALAR_HUMANO")
  order              Int          @default(0)
  // ─── Skills V2 ───────────────────────────────────────────────
  description        String? // Descrição curta para o router (1 linha)
  trigger_keywords   String[]     @default([]) // Hints para o router: ["agendamento", "reuniao"]
  skill_type         String       @default("specialist") // "specialist" | "utility"
  max_context_tokens Int          @default(4000) // Budget de tokens para injeção de references
  provider           String       @default("openai") // "openai" | "anthropic"
  // Onda 18.20 — chip/setor da skill. null = "Geral" (responde em qualquer chip);
  // "COMERCIAL"|"CLINICA"|"FINANCEIRO" = só quando a msg chega naquele chip.
  purpose            String? // null=Geral | COMERCIAL | CLINICA | FINANCEIRO
  // ─────────────────────────────────────────────────────────────
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  messages           Message[]
  tools              SkillTool[]
  assets             SkillAsset[]
}

model SkillTool {
  id              String      @id @default(uuid())
  skill_id        String
  name            String // Nome da função: "book_appointment", "save_form_field"
  description     String // Descrição para function calling
  parameters_json Json // JSON Schema dos parâmetros da função
  handler_type    String // "builtin" | "webhook"
  handler_config  Json        @default("{}") // { "builtin": "book_appointment" } ou { "url": "...", "method": "POST" }
  active          Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  skill           PromptSkill @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([skill_id, name])
  @@index([skill_id])
}

model SkillAsset {
  id           String      @id @default(uuid())
  skill_id     String
  name         String // "PAPEL_TIMBRADO.docx", "expressoes-juridicas.md"
  s3_key       String // Chave no S3/MinIO
  mime_type    String
  size         Int // bytes
  asset_type   String // "asset" | "reference"
  inject_mode  String      @default("none") // "none" | "full_text" | "summary"
  content_text String? // Texto extraído (para references com inject_mode != "none")
  created_at   DateTime    @default(now())
  skill        PromptSkill @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@index([skill_id, asset_type])
}

model SkillExecutionLog {
  id               String   @id @default(uuid())
  // Onda 2.4 (Fase 25) — tenant_id obrigatorio pra auditoria de uso por
  // clinica. Antes ausente: dashboard "qual skill mais usada na clinica X"
  // exigia join via Conversation->Lead. Agora consulta direta + isola tenant.
  // Decisao: PromptSkill/SkillTool/SkillAsset ficam GLOBAIS por design (sao
  // produto compartilhado entre clinicas). Apenas o LOG eh per-tenant.
  tenant_id        String
  conversation_id  String
  skill_id         String?
  tool_calls_json  Json? // Array de tool calls executados
  selection_reason String? // Motivo da seleção pelo router
  router_tokens    Int? // Tokens usados pelo router
  duration_ms      Int?
  created_at       DateTime @default(now())

  @@index([tenant_id, created_at])
  @@index([conversation_id, created_at])
  @@index([skill_id])
}

model AuditLog {
  id            String   @id @default(uuid())
  actor_user_id String?
  action        String
  entity        String
  entity_id     String
  meta_json     Json?
  created_at    DateTime @default(now())
  actor         User?    @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([actor_user_id, created_at])
  @@index([entity, entity_id])
}

model GlobalSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}

/// Onda 17.32.86 — SaaS Fase 3b: catalogo de planos SaaS.
///
/// Substitui a tabela hardcoded em plan-limits.ts quando estiver
/// populado. Plans definem nome, preco mensal (BRL), limites de uso.
model SaasPlan {
  id                String  @id @default(uuid())
  slug              String  @unique
  name              String
  description       String?
  price_monthly     Decimal @default(0) @db.Decimal(10, 2)
  max_users         Int?
  max_patients      Int?
  max_inboxes       Int?
  max_charges_month Int?
  features_json     String?
  active            Boolean @default(true)
  display_order     Int     @default(0)

  // Onda 17.32.87 — @default(now()) tambem em updated_at evita NOT NULL
  // error em prisma db push quando ja ha linhas existentes na tabela.
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  subscriptions SaasSubscription[]
}

/// Onda 17.32.86 — Assinatura SaaS de um tenant.
///
/// Tenant assina um SaasPlan via Asaas (mensalidade). Quando webhook
/// confirma pagamento, atualiza next_charge_date. Cron suspende
/// quando inadimplente >5 dias.
model SaasSubscription {
  id        String @id @default(uuid())
  tenant_id String @unique
  plan_id   String

  /// PENDING_PAYMENT | ACTIVE | PAST_DUE | CANCELLED | TRIALING
  status String @default("PENDING_PAYMENT")

  /// IDs Asaas (do PROPRIO sistema SaaS, nao do tenant)
  asaas_customer_id     String?
  asaas_subscription_id String?
  current_charge_id     String?

  next_charge_date DateTime?
  last_paid_at     DateTime?
  cancelled_at     DateTime?

  billing_type String @default("BOLETO") // PIX | BOLETO | CREDIT_CARD

  // Onda 17.32.87 — @default(now()) tambem em updated_at evita NOT NULL
  // error em prisma db push.
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  plan SaasPlan @relation(fields: [plan_id], references: [id])

  @@index([next_charge_date])
  @@index([status])
}

/// Onda 17.32.80 — SaaS Fase 2: settings POR tenant.
///
/// Quando uma chave existe em TenantSetting{tenant_id, key}, ela
/// SOBRESCREVE o GlobalSetting{key} pra esse tenant. Permite que cada
/// clinica tenha sua propria conta Asaas, instancia Evolution e
/// token ClickSign sem compartilhar com outras.
///
/// Helper getTenantSetting(key, tenantId) ja faz fallback automatico:
///   1. Busca TenantSetting{tenant_id, key}
///   2. Se nao tiver, cai pra GlobalSetting{key}
///   3. Se nao tiver, cai pra env var (CLICKSIGN_API_TOKEN etc)
model TenantSetting {
  tenant_id  String
  key        String
  value      String
  updated_at DateTime @updatedAt

  @@id([tenant_id, key])
  @@index([tenant_id])
}

model AiUsage {
  id                String   @id @default(uuid())
  // Onda 2.2 (Fase 25) — tenant_id obrigatorio pra isolar custos por clinica.
  // Antes estava AUSENTE: clinica A podia ler custos de IA da clinica B
  // via query direta. Vazamento entre tenants.
  tenant_id         String
  conversation_id   String?
  skill_id          String?
  model             String
  call_type         String // 'chat' | 'memory' | 'whisper'
  prompt_tokens     Int      @default(0)
  completion_tokens Int      @default(0)
  total_tokens      Int      @default(0)
  // Onda 2.2 (Fase 25) — Decimal(10, 6) substitui Float pra precisao
  // monetaria. Float acumula imprecisao em centavos ao agregar (SUM, AVG).
  // 6 casas decimais cobrem custos pequenos (1 token Sonnet ~ $0.000003).
  cost_usd          Decimal  @default(0) @db.Decimal(10, 6)
  created_at        DateTime @default(now())

  // Onda 2.2 — index principal pra dashboard "custo IA por mes do tenant"
  @@index([tenant_id, created_at])
  @@index([created_at])
  @@index([model])
  @@index([conversation_id])
}

model Inbox {
  id            String         @id @default(uuid())
  tenant_id     String?
  name          String
  color         String? // hex (#ef4444) escolhido na UI para identificação visual
  // Onda 17.64 — função/equipe do inbox, espelha Instance.purpose (fonte da verdade
  // é a Instance). null = legado "geral". 'COMERCIAL' (Leads) | 'CLINICA' (Pacientes).
  purpose       String?
  auto_route    Boolean        @default(false) // se true, IA roteia automaticamente (antes vivia em Sector)
  rr_pointer    String? // ID do ultimo usuario atribuido (round-robin)
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  tenant        Tenant?        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  users         User[]
  conversations Conversation[]
  instances     Instance[]

  @@index([tenant_id])
}

model Instance {
  id         String   @id @default(uuid())
  tenant_id  String?
  inbox_id   String?
  name       String   @unique
  type       String   @default("whatsapp")
  connection String   @default("evolution")
  // Onda 17.64 — função do chip, designada ANTES do QR. null = legado "geral"
  // (comportamento atual). 'COMERCIAL' = gera Leads (time comercial) | 'CLINICA'
  // = atende Pacientes (recepção/dentistas). Roteia entrada (via inbox) e saída.
  purpose    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  inbox      Inbox?   @relation(fields: [inbox_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([inbox_id])
  @@index([tenant_id, purpose])
}

// ─── Histórico unificado de disparos (Onda 17.60) ─────────────────────────────
// Registra CADA disparo automático pro paciente/dentista que NÃO tem tabela
// própria: aniversário, resumo do dentista e a "consulta agendada/remarcada"
// imediata. Lembrete (EventReminder), Confirmação (AppointmentConfirmation) e NPS
// (PostCareSurvey) já têm tabela — o histórico unificado LÊ esta + aquelas. Tabela
// additive (db push só cria, não toca nas existentes). Status atualizável depois
// via webhook pelo external_message_id.
model DispatchLog {
  id                  String   @id @default(uuid())
  tenant_id           String?
  // aniversario | resumo_dentista | agendamento_criado | agendamento_remarcado
  type                String
  channel             String   @default("WHATSAPP") // WHATSAPP | EMAIL | PUSH
  recipient_name      String?
  recipient_phone     String?
  status              String   @default("SENT") // SENT | FAILED | DELIVERED | READ
  error               String?
  external_message_id String?
  ref_event_id        String? // CalendarEvent, quando aplicável
  ref_patient_id      String?
  ref_user_id         String? // dentista (resumo), quando aplicável
  sent_at             DateTime @default(now())
  created_at          DateTime @default(now())

  @@index([tenant_id, sent_at])
  @@index([external_message_id])
  @@index([type])
}

// ─── CRM Dinâmico — Fase 1 ────────────────────────────────────────────────
// Múltiplos funis por tenant (ex: "Odontologia", "Estética Facial", "B2B").
// Cada funil tem etapas configuráveis via UI (settings/pipelines). A IA carrega
// os funis dinamicamente antes de cada resposta e sabe mover o lead entre
// etapas via tool `move_to_stage`.

model Pipeline {
  id          String   @id @default(uuid())
  tenant_id   String?
  name        String // "Odontologia", "Estética Facial"
  slug        String // "odonto", "estetica" — usado pela IA pra classificar
  description String? // Contexto pra a IA entender quando usar esse funil
  color       String? // hex visual (#3b82f6)
  is_default  Boolean  @default(false)
  is_active   Boolean  @default(true)
  position    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant Tenant?         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  leads  Lead[]

  @@unique([tenant_id, slug])
  @@index([tenant_id])
}

model PipelineStage {
  id                    String   @id @default(uuid())
  pipeline_id           String
  name                  String // "Qualificando", "Aguardando documentos"
  slug                  String // "qualificando" — usado pela IA
  color                 String? // hex (#3b82f6)
  emoji                 String? // 🔍 📋 📅
  description           String? // Descreve QUANDO a IA deve mover o lead pra essa etapa
  position              Int      @default(0)
  is_initial            Boolean  @default(false) // lead novo cai aqui
  is_won                Boolean  @default(false) // converteu (ex: FINALIZADO)
  is_lost               Boolean  @default(false) // perdeu (ex: PERDIDO)
  // Oculta a coluna no Kanban CRM. Usado pra "graduar" leads que sairam
  // do funil de captacao e foram pro funil de Fechamentos (orcamento criado).
  // Continuam visiveis em /atendimento/fechamentos pelo Quote vinculado.
  is_hidden_from_kanban Boolean  @default(false)
  // Auto-ações disparadas ao entrar nessa etapa.
  // Formato: [{ type: "create_drive_folder" }, { type: "enroll_followup", sequence_id: "..." }]
  auto_actions          Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  leads    Lead[]   @relation("CurrentStage")

  @@unique([pipeline_id, slug])
  @@index([pipeline_id])
}

model TransferAudio {
  id              String   @id @default(uuid())
  conversation_id String
  s3_key          String
  mime_type       String   @default("audio/webm")
  size            Int?
  uploaded_by_id  String?
  expires_at      DateTime // 7 dias apos upload — apagado pelo cron
  created_at      DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  uploaded_by  User?        @relation("AudioUploader", fields: [uploaded_by_id], references: [id], onDelete: SetNull)

  @@index([conversation_id])
  @@index([expires_at])
}

model LpEvent {
  id           String   @id @default(uuid())
  page_path    String // "/", "/geral/arapiraca", "/lp/teste"
  event_type   String // "view" | "whatsapp_click"
  visitor_id   String?
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_term     String?
  utm_content  String?
  gclid        String?
  referrer     String?
  created_at   DateTime @default(now())

  @@index([page_path, created_at])
  @@index([event_type])
}

model TaskComment {
  id         String   @id @default(uuid())
  task_id    String
  user_id    String
  text       String
  created_at DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([task_id, created_at])
}

model TaskChecklistItem {
  id         String   @id @default(cuid())
  task_id    String
  text       String
  done       Boolean  @default(false)
  position   Int      @default(0)
  created_at DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
}

// ===============================================
// Follow-up IA — Sequências e Envios
// ===============================================

model FollowupSequence {
  id                 String               @id @default(cuid())
  tenant_id          String?
  name               String
  description        String?
  category           String               @default("LEADS") // LEADS | CLIENTS | COBRANCA | REENGAJAMENTO
  active             Boolean              @default(true)
  auto_enroll_stages String[]             @default([]) // ex: ["NOVO","QUALIFICANDO"]
  max_attempts       Int                  @default(6)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  tenant             Tenant?              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  steps              FollowupStep[]
  enrollments        FollowupEnrollment[]
}

model FollowupStep {
  id            String            @id @default(cuid())
  sequence_id   String
  position      Int
  delay_hours   Int               @default(24)
  channel       String            @default("whatsapp") // whatsapp | email | ligacao
  tone          String            @default("amigavel") // amigavel | profissional | empatico | firme
  objective     String
  custom_prompt String?           @db.Text
  auto_send     Boolean           @default(true)
  created_at    DateTime          @default(now())
  sequence      FollowupSequence  @relation(fields: [sequence_id], references: [id], onDelete: Cascade)
  messages      FollowupMessage[]

  @@index([sequence_id, position])
}

model FollowupEnrollment {
  id            String            @id @default(cuid())
  lead_id       String
  sequence_id   String
  current_step  Int               @default(1)
  status        String            @default("ATIVO") // ATIVO | PAUSADO | CONCLUIDO | CANCELADO | CONVERTIDO
  enrolled_at   DateTime          @default(now())
  last_sent_at  DateTime?
  next_send_at  DateTime?
  paused_reason String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  lead          Lead              @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  sequence      FollowupSequence  @relation(fields: [sequence_id], references: [id], onDelete: Cascade)
  messages      FollowupMessage[]

  @@unique([lead_id, sequence_id])
  @@index([status, next_send_at])
}

model FollowupMessage {
  id             String             @id @default(cuid())
  enrollment_id  String
  step_id        String
  lead_id        String
  channel        String
  generated_text String             @db.Text
  sent_text      String?            @db.Text
  status         String             @default("PENDENTE_APROVACAO") // PENDENTE_APROVACAO | APROVADO | ENVIADO | REJEITADO | FALHOU
  approved_by    String?
  approved_at    DateTime?
  sent_at        DateTime?
  context_json   Json?
  risk_level     String             @default("baixo")
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  enrollment     FollowupEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  step           FollowupStep       @relation(fields: [step_id], references: [id], onDelete: Cascade)

  @@index([enrollment_id])
  @@index([status])
  @@index([lead_id])
}

// ===============================================
// Broadcast / Disparos em Massa
// ===============================================

model BroadcastJob {
  id            String    @id @default(cuid())
  tenant_id     String?
  name          String
  type          String    @default("AUDIENCIA")
  status        String    @default("PENDENTE")
  filter_json   Json?
  custom_prompt String?   @db.Text
  total_targets Int       @default(0)
  sent_count    Int       @default(0)
  failed_count  Int       @default(0)
  interval_ms   Int       @default(10000)
  started_at    DateTime?
  completed_at  DateTime?
  created_by_id String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  tenant     Tenant?         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  created_by User            @relation(fields: [created_by_id], references: [id])
  items      BroadcastItem[]

  @@index([tenant_id, status])
  @@index([created_at])
}

model BroadcastItem {
  id             String    @id @default(cuid())
  broadcast_id   String
  lead_id        String
  event_id       String?
  phone          String
  generated_text String?   @db.Text
  status         String    @default("PENDENTE")
  sent_at        DateTime?
  error          String?
  created_at     DateTime  @default(now())

  broadcast BroadcastJob @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  lead      Lead         @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([broadcast_id, status])
  @@index([lead_id])
}

// ===============================================
// Calendar / Agenda
// ===============================================

model CalendarEvent {
  id          String    @id @default(uuid())
  tenant_id   String?
  type        String // CONSULTA, TAREFA, AUDIENCIA, PRAZO, OUTRO
  title       String
  description String?
  start_at    DateTime
  end_at      DateTime?
  all_day     Boolean   @default(false)
  status      String    @default("AGENDADO") // AGENDADO, CONFIRMADO, CONCLUIDO, CANCELADO, ADIADO
  priority    String    @default("NORMAL") // BAIXA, NORMAL, ALTA, URGENTE
  color       String?
  location    String?

  lead_id             String?
  patient_id          String?
  conversation_id     String?
  assigned_user_id    String?
  created_by_id       String
  appointment_type_id String?
  // Fase 7 — agenda multi-recurso
  room_id             String?

  // Recurrence
  recurrence_rule String? // DAILY, WEEKLY, BIWEEKLY, MONTHLY, CUSTOM
  recurrence_end  DateTime?
  recurrence_days Int[]           @default([]) // dias da semana para CUSTOM (0-6)
  parent_event_id String?
  parent_event    CalendarEvent?  @relation("RecurrenceChildren", fields: [parent_event_id], references: [id], onDelete: Cascade)
  child_events    CalendarEvent[] @relation("RecurrenceChildren")

  lead             Lead?            @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  patient          Patient?         @relation("PatientAppointments", fields: [patient_id], references: [id], onDelete: SetNull)
  conversation     Conversation?    @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  assigned_user    User?            @relation("EventAssigned", fields: [assigned_user_id], references: [id], onDelete: SetNull)
  created_by       User             @relation("EventCreator", fields: [created_by_id], references: [id])
  appointment_type AppointmentType? @relation(fields: [appointment_type_id], references: [id], onDelete: SetNull)

  reminders             EventReminder[]
  comments              CalendarEventComment[]
  task                  Task?
  tenant                Tenant?                       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  // Odontologia (Fase 2)
  clinical_notes        ClinicalNote[]                @relation("AppointmentNotes")
  treatment_plan_items  TreatmentPlanItem[]           @relation("TreatmentPlanItemAppointment")
  // Estetica facial + estoque (Fase 6)
  esthetic_applications EstheticApplication[]         @relation("AppointmentEstheticApplications")
  stock_movements       StockMovement[]               @relation("AppointmentStockMovements")
  // Onda 5 (Fase 25) — manutencoes (CalendarEvent criado pra agendar a revisita)
  maintenance_tasks     MaintenanceTask[]             @relation("MaintenanceTaskEvent")
  // Agenda evoluida (Fase 7)
  room                  Room?                         @relation("AppointmentRoom", fields: [room_id], references: [id], onDelete: SetNull)
  markers               AppointmentMarkerAssignment[] @relation("AppointmentMarkers")
  confirmations         AppointmentConfirmation[]     @relation("AppointmentConfirmations")
  source_return_alerts  ReturnAlert[]                 @relation("AppointmentSourceAlerts")
  scheduled_by_alert    ReturnAlert[]                 @relation("AppointmentScheduledByAlert")
  // Pos-atendimento (Fase 26)
  post_care_survey      PostCareSurvey?

  created_by_ai Boolean @default(false) // true quando o evento foi criado por tool da IA (book_appointment)

  // Validacao clinica (Fase 23) — atestacao do dentista de que o atendimento
  // realmente aconteceu. Separado de status=CONCLUIDO (que pode ser marcado
  // pela recepcao). So o assigned_user OU admin valida; reversao so admin.
  validated_at         DateTime?
  validated_by_user_id String?
  validated_by         User?     @relation("EventValidator", fields: [validated_by_user_id], references: [id], onDelete: SetNull)
  validation_notes     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id, start_at])
  @@index([assigned_user_id, start_at])
  @@index([lead_id])
  @@index([parent_event_id])
  @@index([patient_id, start_at])
  @@index([room_id, start_at])
  @@index([validated_at])
}

model EventReminder {
  id                  String        @id @default(uuid())
  event_id            String
  event               CalendarEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  minutes_before      Int // 15, 30, 60, 1440 (1 dia)
  channel             String        @default("PUSH") // PUSH, WHATSAPP, EMAIL
  sent_at             DateTime?
  // Onda 5e v24 (Fase 25, Onda B) — motivo de falha do envio.
  // Capturado pelo worker quando Evolution API retorna erro
  // (telefone invalido, sem WhatsApp, instance offline, etc).
  // Mostrado na UI da aba Lembretes pro operador investigar.
  last_error          String?
  // Onda 5e v25 (Fase 25, Onda C) — Delivery tracking via webhook
  // messages.update do Evolution. external_message_id liga o reminder
  // a Message correspondente; webhook atualiza delivered_at quando
  // status=DELIVERY_ACK e read_at quando status=READ.
  external_message_id String?
  delivered_at        DateTime?
  read_at             DateTime?

  @@index([event_id])
  @@index([external_message_id])
}

model UserSchedule {
  id          String  @id @default(uuid())
  user_id     String
  user        User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  day_of_week Int // 0=dom, 1=seg, ..., 6=sab
  start_time  String // "09:00"
  end_time    String // "18:00"
  // Onda 5e v10 (Fase 25) — lunch_start/lunch_end mantidos por backward compat
  // (configs antigas continuam funcionando). Recomendacao nova: criar 2 turnos
  // (manha + tarde) ao inves de usar lunch_*. UI nova nao expoe almoco — gera
  // multiplas linhas pro mesmo day_of_week.
  lunch_start String? // "12:00" — null = sem pausa
  lunch_end   String? // "13:00"
  // Onda 5e v10 — label opcional pra distinguir turnos no UI ("Manhã", "Tarde",
  // "Plantão", "Sábado parcial"). Null = sem rotulo (fallback no front mostra
  // start_time-end_time).
  label       String?
  // Ordenacao explicita pra UI mostrar manha antes da tarde (ou ordem custom).
  // Default 0 — multiplos turnos do mesmo dia ordenam por sort_order ASC,
  // depois start_time ASC pra desempate.
  sort_order  Int     @default(0)

  // Removido @@unique([user_id, day_of_week]) pra permitir multiplos turnos
  // no mesmo dia (ex: Manha 08-12 + Tarde 14-18 + Plantao 19-22).
  @@index([user_id, day_of_week])
}

model AppointmentType {
  id        String  @id @default(uuid())
  tenant_id String?
  name      String // "Consulta Trabalhista 30min"
  duration  Int // minutos
  color     String?
  active    Boolean @default(true)

  events CalendarEvent[]
  tenant Tenant?         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

model Holiday {
  id               String   @id @default(uuid())
  tenant_id        String?
  date             DateTime
  name             String
  recurring_yearly Boolean  @default(false)
  created_at       DateTime @default(now())

  tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, date])
}

// ===============================================
// Schedule Block (Fase 25 — Onda 5e v9)
// Bloqueia agenda do dentista por periodo (ferias, doenca, curso, etc).
// IA respeita esses bloqueios em check_availability + book_appointment.
// Diferente de UserSchedule (recorrente semanal), aqui sao janelas
// pontuais com data inicio/fim. Pode ser dia inteiro (all_day = true)
// ou intervalo de horas especifico.
// ===============================================

model ScheduleBlock {
  id         String   @id @default(uuid())
  tenant_id  String?
  user_id    String // dentista bloqueado
  start_at   DateTime // inicio do bloqueio (timezone UTC naive como CalendarEvent)
  end_at     DateTime // fim do bloqueio (inclusive)
  all_day    Boolean  @default(false) // true = ignora horas, bloqueia dia inteiro
  reason     String // "Ferias", "Doenca", "Curso", "Compromisso pessoal", etc
  notes      String? // detalhes opcionais (ex: "Atestado medico")
  created_by String? // user_id de quem criou (admin/recepcao)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user    User    @relation("ScheduleBlockUser", fields: [user_id], references: [id], onDelete: Cascade)
  creator User?   @relation("ScheduleBlockCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([user_id, start_at, end_at])
  @@index([tenant_id, start_at])
}

