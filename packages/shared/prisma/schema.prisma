model PaymentGatewayCharge {
  id                   String   @id @default(uuid())
  tenant_id            String?
  transaction_id       String?  @unique
  // Fase 18 — odontologia: cobranca pode estar vinculada a uma Installment
  installment_id       String?  @unique
  gateway              String   @default("ASAAS")
  external_id          String   @unique // ID da cobrança no gateway
  customer_external_id String // ID do cliente no gateway
  billing_type         String // PIX, BOLETO, CREDIT_CARD
  amount               Decimal
  due_date             DateTime
  status               String   @default("PENDING") // PENDING, RECEIVED, CONFIRMED, OVERDUE, REFUNDED, DELETED, CANCELLED
  description          String?

  // PIX
  pix_qr_code         String?
  pix_copy_paste      String?
  pix_expiration_date DateTime?

  // Boleto
  boleto_url     String?
  boleto_barcode String?

  // Resultado
  invoice_url     String?
  paid_at         DateTime?
  payment_date    DateTime?
  net_value       Decimal?
  webhook_payload Json?

  // Onda 17.32.182 — dedup do lembrete "vence amanha" (cron diario)
  due_reminder_sent_at DateTime?

  /// Onda 14.59 — Vincula direto ao TreatmentPlan (pra sinal/entrada que nao
  /// passam por Installment). Permite query "todas charges deste plan".
  treatment_plan_id String?

  /// Onda 14.59 — Tipo da cobranca dentro do plan. SINAL/ENTRADA disparam
  /// trigger quando ambas pagas; INSTALLMENT eh consequencia. null = legado.
  kind String? // SINAL|ENTRADA|INSTALLMENT

  /// Onda 14.59 — Recebido em especie (admin/financeiro marca manualmente
  /// no lugar do Asaas notificar). Funciona como se webhook tivesse chegado.
  received_in_cash    Boolean   @default(false)
  received_by_user_id String?
  received_at         DateTime?

  idempotency_key String?  @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  lead_honorario_payment_id String?               @unique
  lead_honorario_payment    LeadHonorarioPayment? @relation(fields: [lead_honorario_payment_id], references: [id], onDelete: SetNull)
  transaction               FinancialTransaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  tenant                    Tenant?               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  installment               Installment?          @relation(fields: [installment_id], references: [id], onDelete: SetNull)
  /// Onda 14.59
  treatment_plan            TreatmentPlan?        @relation(fields: [treatment_plan_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, status])
  @@index([customer_external_id])
  @@index([due_date, status])
  @@index([installment_id])
  @@index([treatment_plan_id, kind])
}

