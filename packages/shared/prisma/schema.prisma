// ===============================================
// Memory System — Lead + Organization memories
// ===============================================

/// Memória persistente sobre leads e sobre o escritório. Cada Memory é uma
/// unidade atômica de conhecimento (1 frase / fato). A coluna `embedding`
/// (pgvector) é adicionada via migration SQL — Prisma não suporta vector
/// nativamente. Use $queryRaw/$executeRaw para operações envolvendo embedding.
model Memory {
  id        String @id @default(uuid())
  tenant_id String

  /// "lead" | "organization"
  scope    String
  /// ID do lead (scope=lead) ou ID do tenant (scope=organization)
  scope_id String

  /// "semantic" | "episodic" | "procedural"
  type        String  @default("semantic")
  /// Subcategoria (scope=organization): office_info | team | fees | procedures | court_info | legal_knowledge | contacts | rules
  subcategory String?

  content String @db.Text

  /// Embedding OpenAI text-embedding-3-small (1536 dim). Tipo pgvector —
  /// Prisma nao suporta nativamente, entao usamos Unsupported. Isso impede
  /// que `prisma db push` REMOVA a coluna por nao reconhece-la no schema.
  /// Leitura/escrita sempre via $queryRawUnsafe/$executeRawUnsafe.
  /// IMPORTANTE: a extensao pgvector deve estar habilitada no Postgres antes
  /// do primeiro `db push` em ambientes novos — ver manual-sql/2026-04-18-memory-system.sql.
  embedding Unsupported("vector(1536)")?

  // Proveniência
  /// "batch" | "manual" | "system" | "retroactive"
  source_type String
  /// ID da conversa que originou (quando source_type=batch)
  source_id   String?
  confidence  Float   @default(1.0)

  // Ciclo de vida
  /// "active" | "superseded" | "archived"
  status        String    @default("active")
  /// Razão da substituição ou ID da memória substituta
  superseded_by String?
  access_count  Int       @default(0)
  last_accessed DateTime?
  expires_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, scope, scope_id])
  @@index([status])
  @@index([tenant_id, subcategory])
}

/// Perfil consolidado do lead — summary em texto corrido + facts JSON.
/// Regenerado pelo cron noturno após extração de memórias. É o "cartão" que
/// a IA lê antes de responder para já conhecer o cliente sem repetir perguntas.
model LeadProfile {
  id        String @id @default(uuid())
  tenant_id String
  lead_id   String @unique
  lead      Lead   @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  /// Texto corrido (~300 palavras) — injetado no system prompt
  summary String @db.Text
  /// JSON estruturado: name, cpf, cases[], preferences, pending, sentiment, risk_flags…
  facts   Json   @default("{}")

  generated_at  DateTime @default(now())
  message_count Int      @default(0)
  version       Int      @default(1)

  @@index([tenant_id])
}

/// Perfil consolidado do ESCRITORIO — resumo em prosa (4 secoes) que substitui
/// a injecao crua das memorias organizacionais no prompt. Mesmo padrao do
/// LeadProfile mas para tenant. 1 registro por tenant.
///
/// Regenerado:
///   - Diariamente as 02h (OrgProfileConsolidationProcessor)
///   - Sob demanda apos create/update/delete de memoria organizacional (debounce)
///   - Via botao manual na tela /atendimento/settings/knowledge
///
/// Na injecao, substitui `{{office_memories}}` no prompt — reduz ruido,
/// resolve conflitos e descarta memorias de baixa confianca.
model OrganizationProfile {
  id        String @id @default(uuid())
  tenant_id String @unique
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  /// Texto estruturado em 4 secoes (About, Team, Procedures, Rules) — ~500 palavras
  summary String @db.Text
  /// JSON estruturado: office_info, team[], fees, procedures[], rules[], etc.
  facts   Json   @default("{}")

  /// Quantas memorias ativas foram usadas como fonte na ultima geracao
  source_memory_count Int @default(0)

  /// Timestamp da ultima edicao manual do admin. Quando nao-null, o cron
  /// automatico das 02h PULA este tenant (nao sobrescreve a edicao). Limpo
  /// quando o admin clica "Regenerar" explicitamente via UI/API.
  manually_edited_at DateTime?

  /// Marca ate quando as memorias ja foram incorporadas ao summary
  /// (modo incremental). Na proxima regen incremental, so processa memorias
  /// criadas/deletadas APOS este timestamp — economiza LLM tokens e preserva
  /// o texto existente. Resetado pelo botao "Refazer do zero" (from-scratch).
  last_incorporated_at DateTime?

  generated_at DateTime @default(now())
  version      Int      @default(1)
}

// ============================================================================
// ODONTOLOGIA — Fase 2 — Entidades clinicas core
// ============================================================================
// Models clinicos do Instituto Odonto Passos. Os modelos juridicos foram
// removidos nas Fases 0.1 e 0.2 da refatoracao odontologica.
// ============================================================================

/// Paciente — cliente ativo da clinica. Criado quando um Lead agenda a primeira
/// consulta. Mantem link opcional ao Lead de origem para preservar o historico
/// de conversas WhatsApp.
model Patient {
  id        String  @id @default(uuid())
  tenant_id String
  lead_id   String? @unique

  // Identificacao
  name           String
  cpf            String?
  /// Onda 17.32.184 — numero da ficha/prontuario fisico da clinica.
  /// Pesquisavel junto com nome/CPF; unicidade por tenant validada na API.
  record_number  String?
  rg             String?
  birth_date     DateTime?
  gender         String? // "M" | "F" | "OTHER"
  phone          String?
  email          String?
  marital_status String? // "SOLTEIRO" | "CASADO" | "DIVORCIADO" | "VIUVO" | "UNIAO_ESTAVEL"
  avatar_url     String? // URL S3 da foto de perfil

  // Endereco
  address            String?
  address_number     String?
  address_complement String?
  neighborhood       String?
  city               String?
  state              String?
  zip_code           String?

  // Clinico basico (info nao-sensivel; anamnese tem os dados profundos)
  blood_type              String?
  emergency_contact_name  String?
  emergency_contact_phone String?

  // Responsavel legal (menores de idade ou idosos com curador)
  is_minor       Boolean @default(false)
  guardian_name  String?
  guardian_cpf   String?
  guardian_phone String?

  // Relacionamento clinico
  primary_dentist_id String?
  chief_complaint    String? // queixa principal editavel a partir do overview
  referred_by        String? // legado: texto livre de quem indicou
  referred_by_id     String? // novo: relacao real Patient -> Patient (se indicador for paciente)

  // Status do paciente
  status         String    @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "ARCHIVED"
  first_visit_at DateTime?
  last_visit_at  DateTime?

  // Notas administrativas (nao clinicas — nao e prontuario)
  notes String?

  // Programa de Afiliado (Onda 5e v34, Fase 25)
  // Paciente vira parceiro: recebe 3% de cada tratamento fechado por
  // indicacao dele. Saldo acumula e pode ser sacado (PIX/dinheiro) ou
  // usado como credito em tratamentos proprios.
  is_affiliate             Boolean @default(false)
  affiliate_code           String? // codigo unico de divulgacao (ex: "ANDRELUSTOSA")
  affiliate_commission_pct Decimal @default(3) @db.Decimal(5, 2)
  affiliate_notes          String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant                   Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lead                     Lead?                 @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  primary_dentist          User?                 @relation("PrimaryDentist", fields: [primary_dentist_id], references: [id], onDelete: SetNull)
  // Indicacoes: paciente A indica paciente B
  referred_by_patient      Patient?              @relation("PatientReferrals", fields: [referred_by_id], references: [id], onDelete: SetNull)
  referrals                Patient[]             @relation("PatientReferrals")
  allergies                PatientAllergy[]
  medications              PatientMedication[]
  anamneses                Anamnesis[]
  medical_record           MedicalRecord?
  odontogram               Odontogram?
  clinical_images          ClinicalImage[]
  consents                 ConsentRecord[]
  quotes                   Quote[]
  treatment_plans          TreatmentPlan[]
  appointments             CalendarEvent[]       @relation("PatientAppointments")
  // Estetica facial (Fase 6)
  esthetic_applications    EstheticApplication[]
  adverse_reactions        AdverseReaction[]
  // Onda 5 (Fase 25) — manutencoes/recall
  maintenance_tasks        MaintenanceTask[]
  // Agenda evoluida (Fase 7)
  return_alerts            ReturnAlert[]
  // Comissoes (Fase 8)
  commissions              Commission[]
  // Regua de cobranca (Fase 11)
  installments             Installment[]
  // Portal do paciente (Fase 13)
  portal_tokens            PortalToken[]
  // Smile/Face Design (Fase 16)
  smile_simulations        SmileSimulation[]
  // Radiologia (Fase 17)
  radiography_exams        RadiographyExam[]
  // Tags / segmentacao (Fase 20)
  tags                     PatientTagOnPatient[]
  // Indicacao premiada (Fase 21)
  referrals_given          Referral[]            @relation("ReferralsGiven")
  referral_received        Referral?             @relation("ReferralReceived")
  // Pos-atendimento (Fase 26)
  post_care_surveys        PostCareSurvey[]
  // Programa de Afiliado (Onda 5e v34, Fase 25)
  affiliate_referrals_made AffiliateReferral[]   @relation("AffiliateReferrer")
  affiliate_referrals_via  AffiliateReferral[]   @relation("AffiliateReferred")
  affiliate_withdrawals    AffiliateWithdrawal[]
  // Influenciador (Onda 5e v35) — cadastro de marketing tambem e Patient (1:1 opcional)
  influencer_profile       Influencer?

  @@unique([tenant_id, cpf])
  @@unique([tenant_id, affiliate_code])
  @@index([tenant_id, name])
  @@index([tenant_id, phone])
  @@index([primary_dentist_id])
  @@index([referred_by_id])
  @@index([tenant_id, is_affiliate])
}

// ============================================================================
// FASE 20 — TAGS / SEGMENTACAO DE PACIENTES
// ============================================================================

model PatientTag {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String // "VIP", "Alergia critica", "Sem revisao 6m", etc
  color       String? // hex "#ef4444" — cor do badge
  description String? // tooltip explicativo (opcional)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant   Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patients PatientTagOnPatient[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
}

model PatientTagOnPatient {
  patient_id String
  tag_id     String
  created_at DateTime @default(now())

  patient Patient    @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  tag     PatientTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([patient_id, tag_id])
  @@index([tag_id])
  @@index([patient_id])
}

// ============================================================================
// FASE 21 — INDICAÇÃO PREMIADA (CASHBACK / REFERRAL PROGRAM)
// ============================================================================
//
// Quando um paciente A indica um paciente B (via referred_by_id), uma
// Referral é criada com status PENDING. Quando o paciente B fecha um
// TreatmentPlan (status -> ACCEPTED/ACTIVE), a Referral muda pra EARNED
// e o paciente A passa a ter direito ao cashback (reward_value). O
// admin marca como PAID quando aplica o desconto na próxima parcela
// do paciente A ou paga em dinheiro.
//
// Status:
//  PENDING — paciente B ainda não fechou plano
//  EARNED  — paciente B fechou plano, A tem cashback a receber
//  PAID    — clinica ja aplicou o cashback
//  EXPIRED — passou da validade (definida em ReferralRule.expiration_days)
//  CANCELLED — paciente B nao seguiu / desistiu / cancelou plano

model Referral {
  id          String @id @default(uuid())
  tenant_id   String
  referrer_id String // Patient que indicou
  referred_id String @unique // Patient indicado (1 indicacao por paciente novo)

  status       String  @default("PENDING") // PENDING | EARNED | PAID | EXPIRED | CANCELLED
  reward_value Decimal @default(0) @db.Decimal(10, 2) // Valor do cashback

  // Datas do ciclo
  earned_at  DateTime? // Quando virou EARNED (plano fechado)
  paid_at    DateTime? // Quando admin marcou como PAID
  expires_at DateTime? // Calculado de ReferralRule.expiration_days

  // Vinculo opcional ao plano que disparou o EARNED
  triggering_plan_id String?

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  referrer Patient @relation("ReferralsGiven", fields: [referrer_id], references: [id], onDelete: Cascade)
  referred Patient @relation("ReferralReceived", fields: [referred_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status])
  @@index([referrer_id, status])
  @@index([referred_id])
}

model ReferralRule {
  id                   String   @id @default(uuid())
  tenant_id            String   @unique // 1 regra por tenant
  enabled              Boolean  @default(true)
  default_reward_value Decimal  @default(50) @db.Decimal(10, 2) // R$ por indicação que fecha
  expiration_days      Int      @default(180) // Validade do cashback após EARNED
  notes                String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

// ============================================================================
// MARKETING — Influenciadores (parcerias com criadores de conteúdo)
// ============================================================================
// Cadastro de influenciadores que divulgam a clínica. Isolado dos models
// existentes (Patient/Lead/Referral) — relacionamentos com pacientes/leads
// gerados podem ser adicionados depois sem migração destrutiva.
model Influencer {
  id        String @id @default(uuid())
  tenant_id String

  // Contato
  name   String
  handle String? // @ principal (instagram/tiktok), sem o @
  phone  String?
  email  String?

  // Plataforma e audiência
  platform  String? // INSTAGRAM | TIKTOK | YOUTUBE | OUTRO
  followers Int? // nº seguidores na plataforma principal
  niche     String? // odonto, lifestyle, fitness, beleza, etc.

  // Modelo financeiro acordado
  commission_type  String? // PERCENTUAL | FIXO | PERMUTA
  commission_value Decimal? @db.Decimal(10, 2) // % ou R$ (depende do tipo)
  coupon_code      String? // código de desconto associado (rastreio)

  // Operacional
  status String  @default("ATIVO") // ATIVO | PAUSADO | INATIVO
  notes  String?

  // Onda 5e v35 — influenciador também vira Patient (auto-criado/vinculado no
  // create() do InfluencersService). Permite ficha clínica, agendamento e
  // sistema de afiliado unificados. ON DELETE SET NULL: remover o paciente
  // não cascateia pro influenciador — vínculo é apenas conveniência.
  patient_id String? @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient      Patient?               @relation(fields: [patient_id], references: [id], onDelete: SetNull)
  message_logs InfluencerMessageLog[]

  @@unique([tenant_id, coupon_code]) // cupom único por tenant (quando preenchido)
  @@index([tenant_id, status])
  @@index([tenant_id, name])
}

// ============================================================================
// ONDA 5E V34 — PROGRAMA DE AFILIADO (Fase 25)
// ============================================================================
// Diferente do `Referral` (indicação premiada com valor FIXO em R$), o
// AffiliateReferral usa COMISSÃO PERCENTUAL (default 3%) sobre o valor do
// tratamento fechado. O afiliado e um Patient com is_affiliate=true. O saldo
// acumula a cada Quote ACCEPTED de um indicado, e pode ser sacado em
// dinheiro/PIX ou usado como credito em tratamentos proprios.
//
// Triggered por: hook em QuotesService quando Quote.status vira ACCEPTED e o
// paciente da Quote tem `referred_by_id` apontando pra um Patient afiliado.

model AffiliateReferral {
  id          String  @id @default(uuid())
  tenant_id   String
  referrer_id String // Patient afiliado (recebe a comissao)
  referred_id String // Patient indicado (gerou a comissao)
  quote_id    String? // Quote que gerou (rastreabilidade)

  treatment_value  Decimal @db.Decimal(10, 2) // valor total do tratamento fechado
  commission_pct   Decimal @db.Decimal(5, 2) // % aplicado (snapshot — default 3%)
  commission_value Decimal @db.Decimal(10, 2) // valor calculado da comissao

  status     String   @default("creditado") // creditado | pendente | cancelado
  closed_at  DateTime @default(now()) // quando o tratamento foi fechado
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  referrer Patient @relation("AffiliateReferrer", fields: [referrer_id], references: [id], onDelete: Cascade)
  referred Patient @relation("AffiliateReferred", fields: [referred_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, referrer_id, status])
  @@index([referred_id])
  @@index([quote_id])
}

model AffiliateWithdrawal {
  id         String @id @default(uuid())
  tenant_id  String
  patient_id String // Patient afiliado solicitando saque

  amount  Decimal @db.Decimal(10, 2)
  method  String // PIX | DINHEIRO | CREDITO_TRATAMENTO
  pix_key String? // chave PIX (quando method=PIX)
  status  String  @default("solicitado") // solicitado | pago | recusado

  requested_at    DateTime  @default(now())
  paid_at         DateTime?
  paid_by_user_id String? // user (admin/financeiro) que confirmou pagamento

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  paid_by User?   @relation("AffiliateWithdrawalPaidBy", fields: [paid_by_user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, patient_id, status])
  @@index([status])
}

// ============================================================================
// MARKETING — Mensagens automáticas pra influenciadores
// ============================================================================
//
// Fluxo:
//   1. Admin cria InfluencerMessageTemplate com texto + variáveis ({{nome}},
//      {{handle}}, {{cupom}}).
//   2. Admin cria InfluencerSchedule vinculando template a destinatários
//      (filtro + manual) com tipo ONCE (data única) ou RECURRING.
//   3. Worker cron (a cada minuto) acha schedules com next_run_at <= now()
//      e dispara WhatsApp pra cada destinatário via Evolution API.
//   4. Cada envio vira InfluencerMessageLog (idempotente por scheduled_for).
// ============================================================================

model InfluencerMessageTemplate {
  id        String @id @default(uuid())
  tenant_id String

  name String // nome operacional ("Lembrete semanal de postagem")
  body String @db.Text // texto com variáveis {{nome}} {{handle}} {{cupom}}

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  schedules InfluencerSchedule[]

  @@index([tenant_id])
}

model InfluencerSchedule {
  id        String @id @default(uuid())
  tenant_id String

  name        String // nome da campanha ("Lembrete sextou")
  template_id String
  active      Boolean @default(true)

  // ONCE = envia 1 vez em run_at; RECURRING = usa recurrence + hora
  schedule_type String // ONCE | RECURRING

  // ONCE
  run_at DateTime?

  // RECURRING (campos mutuamente exclusivos por tipo de recorrência)
  recurrence   String? // DAILY | WEEKLY | MONTHLY
  weekdays     Int[]   @default([]) // 0=dom..6=sab — só WEEKLY
  day_of_month Int? // 1-31 — só MONTHLY
  hour         Int? // 0-23 — RECURRING
  minute       Int? // 0-59 — RECURRING

  // Destinatários (combinação aditiva: filtros + lista manual)
  filter_status        String[] @default([]) // ATIVO | PAUSADO | INATIVO
  filter_platform      String[] @default([]) // INSTAGRAM | TIKTOK | YOUTUBE | OUTRO
  filter_niche         String? // contém texto (case-insensitive)
  manual_recipient_ids String[] @default([]) // IDs específicos

  // Estado de execução
  last_run_at DateTime?
  next_run_at DateTime? // o cron usa esse campo pra escolher quem disparar

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  template InfluencerMessageTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)
  logs     InfluencerMessageLog[]

  @@index([tenant_id, active, next_run_at])
  @@index([template_id])
}

model InfluencerMessageLog {
  id            String @id @default(uuid())
  tenant_id     String
  schedule_id   String
  influencer_id String

  // Idempotência: combinação única (schedule, destinatário, ocorrência planejada)
  scheduled_for DateTime // a hora pra qual estava planejado o disparo

  status        String // SENT | FAILED | SKIPPED
  sent_at       DateTime?
  sent_text     String?   @db.Text
  external_id   String? // id retornado pelo Evolution (auditoria)
  error_message String?

  created_at DateTime @default(now())

  tenant     Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  schedule   InfluencerSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  influencer Influencer         @relation(fields: [influencer_id], references: [id], onDelete: Cascade)

  @@unique([schedule_id, influencer_id, scheduled_for])
  @@index([tenant_id, sent_at])
  @@index([schedule_id])
}

model PatientAllergy {
  id         String   @id @default(uuid())
  patient_id String
  allergen   String // ex: "Penicilina", "Latex", "Anestesico local"
  severity   String? // "MILD" | "MODERATE" | "SEVERE"
  notes      String?
  created_at DateTime @default(now())

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
}

model PatientMedication {
  id         String    @id @default(uuid())
  patient_id String
  medication String
  dosage     String? // "500mg"
  frequency  String? // "1x ao dia", "de 8 em 8h"
  reason     String?
  started_at DateTime?
  ended_at   DateTime?
  created_at DateTime  @default(now())

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
}

// ============================================================================
// CATALOGO CLINICO — Specialty + Procedure
// ============================================================================

model Specialty {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String // "Clinica Geral", "Ortodontia" etc.
  description String?
  icon        String? // nome de icone lucide (opcional — UI)
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  procedures Procedure[]
  dentists   User[]      @relation("UserSpecialties")

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
}

model Procedure {
  id           String  @id @default(uuid())
  tenant_id    String
  specialty_id String?

  name          String
  code_tuss     String? // Codigo TUSS (opcional)
  internal_code String? // Codigo interno da clinica

  description         String?
  duration_minutes    Int     @default(30)
  base_price          Decimal @default(0) @db.Decimal(10, 2)
  requires_x_ray      Boolean @default(false)
  requires_anesthesia Boolean @default(false)

  // Fase 6 — Estetica facial
  /// Categoria detalhada (alem de Specialty):
  /// Odonto:    "PROFILAXIA" | "DENTISTICA" | "ENDODONTIA" | "PERIODONTIA"
  ///            "ORTODONTIA" | "IMPLANTE" | "PROTESE" | "CIRURGIA" | "ESTETICA_DENTAL"
  /// Estetica:  "HOF" | "TOXINA_BOTULINICA" | "PREENCHIMENTO_AH"
  ///            "BIOESTIMULADOR" | "FIOS_PDO" | "FIOS_PLLA" | "PEELING_QUIMICO"
  ///            "MICROAGULHAMENTO" | "SKINBOOSTER" | "LASER" | "RADIOFREQUENCIA"
  ///            "ULTRASSOM_MICROFOCADO" | "LIPO_ENZIMATICA" | "LIMPEZA_PELE"
  category String?

  /// Procedimento estetico facial (true) — habilita FacialMap na UI
  is_facial_application       Boolean @default(false)
  /// Validade media do efeito (ex: AH=12, Botox=4-6, Sculptra=24)
  default_revisit_months      Int?
  /// Cuidados pos-procedimento padrao (texto informativo ao paciente)
  post_procedure_instructions String?

  /// Onda 17.67 — se false, este procedimento NAO gera comissao (nem venda, nem execucao). Default: comissiona.
  commissionable Boolean @default(true)

  /// Se true, o procedimento aparece na VENDA RAPIDA (catalogo curado pelo admin
  /// na Tabela de Precos). Default false: a Venda Rapida mostra SO os autorizados.
  quick_sale Boolean @default(false)

  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant                Tenant                     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  specialty             Specialty?                 @relation(fields: [specialty_id], references: [id], onDelete: SetNull)
  quote_items           QuoteItem[]
  treatment_plan_items  TreatmentPlanItem[]
  // Fase 6
  consumables           ProcedureConsumable[]
  esthetic_applications EstheticApplication[]
  // Onda 5 (Fase 25) — manutencoes geradas a partir desse procedimento
  maintenance_tasks     MaintenanceTask[]
  adverse_reactions     AdverseReaction[]          @relation("ProcedureAdverseReactions")
  // Fase 8 — comissoes
  commissions           Commission[]               @relation("CommissionProcedure")
  // Onda 2 orcamentos (Fase 24)
  quote_template_items  QuoteTemplateItem[]
  // Onda 3.2 — sugestoes automaticas vinculadas a este procedimento
  state_suggestions     StateProcedureSuggestion[]

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
  @@index([tenant_id, category])
  @@index([specialty_id])
}

// ============================================================================
// ANAMNESE — Template versionado + respostas do paciente
// ============================================================================

/// Template de perguntas (1 por tenant, versionado). Admin pode editar;
/// anamneses ja preenchidas preservam snapshot do schema vigente na hora.
model AnamnesisTemplate {
  id        String @id @default(uuid())
  tenant_id String
  version   Int    @default(1)

  /// Estrutura das perguntas:
  /// { "sections": [ { "id": "...", "title": "...", "questions": [...] } ] }
  schema Json

  active     Boolean  @default(true)
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  anamneses Anamnesis[]

  @@unique([tenant_id, version])
  @@index([tenant_id, active])
}

/// Onda 17.32.112 — Ficha de anamnese MASTER do SaaS.
/// Existe apenas 1 registro (singleton, id fixo = 1).
/// So SUPER_ADMIN edita. Quando salva, propaga em UPSERT pra todos
/// os tenants (AnamnesisTemplate v3 deles vira espelho desta).
/// Tenants veem em modo read-only.
model GlobalAnamnesisTemplate {
  id      Int  @id @default(1)
  version Int  @default(1)
  /// Mesmo schema do AnamnesisTemplate (sections, questions).
  schema  Json
  notes   String?

  /// Quem foi o ultimo SUPER_ADMIN que salvou.
  updated_by_user_id String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("global_anamnesis_template")
}

// ============================================================================
// FASE 26 — PESQUISA DE SATISFACAO POS-ATENDIMENTO
// ============================================================================

/// Pesquisa de satisfacao disparada automaticamente apos consulta concluida.
/// Cron escaneia CalendarEvent com status=CONCLUIDO, cria survey PENDING,
/// agenda job no worker pra disparar via Evolution apos delay configurado
/// (default 2h). Resposta do paciente eh capturada pelo webhook do Evolution
/// e classificada por sentimento — respostas NEGATIVE notificam admins.
model PostCareSurvey {
  id                String  @id @default(uuid())
  tenant_id         String
  patient_id        String
  appointment_id    String? @unique // 1 survey por consulta
  dentist_id        String?
  /// Resumo do procedimento (vindo do CalendarEvent.title) usado no template
  procedure_summary String?

  /// Quando o job de envio deve disparar (start_at + delay)
  trigger_at DateTime
  sent_at    DateTime?
  /// PENDING | SENT | RESPONDED | FAILED | SKIPPED
  status     String    @default("PENDING")

  /// 1-5 ou 1-10 se mencionado pelo paciente na resposta (regex)
  score        Int?
  /// POSITIVE | NEGATIVE | NEUTRAL — analisado por keywords pt-BR
  sentiment    String?
  /// Texto livre da resposta do paciente
  comment      String?
  responded_at DateTime?
  /// Quando os admins foram notificados (sentiment NEGATIVE)
  escalated_at DateTime?

  /// ID da mensagem no Evolution (pra rastrear na conversa)
  evolution_message_id String?
  /// Erro do disparo (se houver)
  last_error           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant      Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient     Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  appointment CalendarEvent? @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  dentist     User?          @relation("PostCareSurveyDentist", fields: [dentist_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, status, trigger_at])
  @@index([tenant_id, sentiment])
  @@index([patient_id, sent_at])
}

model Anamnesis {
  id          String @id @default(uuid())
  patient_id  String
  template_id String

  /// Respostas: { "question_id": "answer" }
  answers         Json @default("{}")
  /// Snapshot do schema usado (preserva historico mesmo se template mudar)
  template_schema Json

  filled_by_user_id String?
  filled_at         DateTime @default(now())
  updated_at        DateTime @updatedAt

  // ─── Prova eletronica de preenchimento (Fase 26) ────────────────
  /// "STAFF" (equipe preencheu) | "PATIENT_PORTAL" (paciente preencheu via portal)
  submitted_via        String?
  submitted_ip         String?
  submitted_user_agent String?
  /// Snapshot do termo de consentimento aceito (preserva texto original)
  consent_text         String?
  consent_accepted_at  DateTime?
  /// "TYPED_NAME" | "DRAWN"
  signature_method     String?
  /// Nome digitado ou data-url base64 da assinatura desenhada
  signature_data       String?
  /// Selfie capturada no momento do consent (data-url JPEG comprimido) — prova facial
  selfie_data          String?
  /// SHA-256 hex de answers + ip + ua + timestamp + signature_data + selfie_data — fingerprint de integridade
  audit_hash           String?

  patient  Patient           @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  template AnamnesisTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)

  @@index([patient_id, filled_at])
}

// ============================================================================
// PRONTUARIO — MedicalRecord + ClinicalNote (SOAP)
// ============================================================================

/// Raiz do prontuario. 1 por paciente. Armazena meta-info; as notas reais ficam
/// em ClinicalNote.
model MedicalRecord {
  id              String  @id @default(uuid())
  patient_id      String  @unique
  chief_complaint String? // queixa principal
  history         String? // historia da doenca atual

  opened_at  DateTime  @default(now())
  closed_at  DateTime? // quando paciente recebe alta
  updated_at DateTime  @updatedAt

  patient Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  notes   ClinicalNote[]

  @@index([patient_id])
}

/// Nota clinica (formato SOAP). Imutavel apos is_finalized=true (so addendum).
model ClinicalNote {
  id                String  @id @default(uuid())
  medical_record_id String
  appointment_id    String?
  author_user_id    String

  subjective String? // "S" — relato do paciente
  objective  String? // "O" — exame clinico
  assessment String? // "A" — diagnostico
  plan       String? // "P" — plano imediato

  /// IDs de TreatmentPlanItem executados nesta sessao
  executed_items String[] @default([])

  is_finalized Boolean   @default(false)
  finalized_at DateTime?

  /// Correcao apos finalizacao — so adiciona, nao sobrescreve
  addendum    String?
  addendum_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  medical_record        MedicalRecord         @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)
  author                User                  @relation("ClinicalNoteAuthor", fields: [author_user_id], references: [id], onDelete: Restrict)
  appointment           CalendarEvent?        @relation("AppointmentNotes", fields: [appointment_id], references: [id], onDelete: SetNull)
  clinical_images       ClinicalImage[]
  // Estetica facial (Fase 6) — aplicacoes registradas nesta nota
  esthetic_applications EstheticApplication[] @relation("ClinicalNoteEstheticApplications")

  @@index([medical_record_id, created_at])
  @@index([author_user_id])
  @@index([appointment_id])
}

// ============================================================================
// ODONTOGRAMA — Odontogram + ToothRecord (notacao FDI)
// ============================================================================

/// Estado odontologico atual. 1 por paciente. Dentes higidos nao geram
/// ToothRecord — so os que tem anotacao (carie, restauracao, ausencia, etc).
model Odontogram {
  id         String @id @default(uuid())
  patient_id String @unique

  /// Meta JSON: { "dentition_stage": "permanent"|"mixed"|"deciduous", "notes": "..." }
  meta Json @default("{}")

  last_updated_by_user_id String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  patient Patient       @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  teeth   ToothRecord[]
}

/// Registro de dente. Notacao FDI: 11-48 (permanente), 51-85 (deciduo).
model ToothRecord {
  id            String  @id @default(uuid())
  odontogram_id String
  tooth_fdi     String // "11", "36", "51"
  face          String? // "M","D","O","V","L","INCISAL" ou null = dente inteiro

  state    String // "CARIE","RESTAURADO","AUSENTE","PROTESE","IMPLANTE","ENDODONTIA","EXTRACAO_INDICADA","COROA","FRATURA","OUTROS"
  material String? // "COMPOSITE","AMALGAMA","PORCELANA","METAL"

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  odontogram Odontogram @relation(fields: [odontogram_id], references: [id], onDelete: Cascade)

  @@index([odontogram_id, tooth_fdi])
}

// ============================================================================
// SUGESTOES AUTOMATICAS — Mapping de estado clinico -> procedimento (Onda 3.2)
// ============================================================================

/// Mapping configuravel POR TENANT: quando dentista anota um estado clinico
/// (ex: "CARIE"), sistema sugere automaticamente um procedimento no orcamento
/// (ex: Restauracao em resina). Reduz cliques de anotar->orcar de ~4 pra 2.
///
/// Pode haver MULTIPLAS sugestoes pro mesmo estado — priority decide ordem.
/// Se nao houver mapping, fluxo cai pro picker manual (UX atual).
model StateProcedureSuggestion {
  id           String @id @default(uuid())
  tenant_id    String
  state        String // "CARIE", "EXTRACAO_INDICADA", "ENDODONTIA", "COROA", etc.
  procedure_id String
  /// Quando ha varias sugestoes pro mesmo estado, menor priority aparece primeiro
  priority     Int    @default(0)

  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedure_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, state, procedure_id])
  @@index([tenant_id, state, active])
}

// ============================================================================
// IMAGENS CLINICAS — Raio-X, foto intraoral, foto facial
// ============================================================================

model ClinicalImage {
  id               String  @id @default(uuid())
  patient_id       String
  media_id         String? // link com Media (binario)
  clinical_note_id String?

  kind        String // "XRAY_PANORAMIC","XRAY_BITEWING","XRAY_PERIAPICAL","PHOTO_INTRAORAL_FRONT","PHOTO_INTRAORAL_OCCLUSAL","PHOTO_FACE","PHOTO_OTHER"
  tooth_fdi   String?
  description String?
  date_taken  DateTime

  uploaded_by_user_id String?
  created_at          DateTime @default(now())

  patient       Patient       @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  clinical_note ClinicalNote? @relation(fields: [clinical_note_id], references: [id], onDelete: SetNull)

  @@index([patient_id, date_taken])
  @@index([clinical_note_id])
}

// ============================================================================
// CONSENTIMENTO — LGPD + TCLE + Imagem
// ============================================================================

model ConsentRecord {
  id                String  @id @default(uuid())
  patient_id        String
  treatment_plan_id String?

  type         String // "LGPD_DATA_PROCESSING" | "TREATMENT_CONSENT" | "IMAGE_USE" | "ANESTHESIA"
  version_text String // versao do termo aceito (texto/identificador)

  consented_at         DateTime @default(now())
  consented_by_user_id String?
  ip_address           String?
  user_agent           String?

  // ClickSign (quando aplicavel — TCLE clinico de plano)
  clicksign_document_key String?
  clicksign_signed_at    DateTime?
  signed_document_s3_key String?

  // Revogacao (LGPD direito ao esquecimento)
  revoked_at     DateTime?
  revoked_reason String?

  created_at DateTime @default(now())

  patient        Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  treatment_plan TreatmentPlan? @relation(fields: [treatment_plan_id], references: [id], onDelete: SetNull)

  @@index([patient_id, type])
  @@index([treatment_plan_id])
}

// ============================================================================
// ORCAMENTO + PLANO DE TRATAMENTO
// ============================================================================

model Quote {
  id                 String @id @default(uuid())
  patient_id         String
  created_by_user_id String

  /// Onda 14.18 — Numero sequencial GLOBAL por tenant. Auto-incrementado
  /// no create via MAX(quote_number)+1 do tenant. Imutavel apos criacao.
  /// Usado como identificador unificado entre as abas Avaliacao/Orcamentos/
  /// Propostas/Financeiro pra operador ter facilidade de localizar.
  quote_number Int @default(0)

  /// Onda 3.9 — Nome customizavel pelo operador (ex: "Reabilitacao superior",
  /// "Canal + coroa 36"). Independente da closing_category derivada por
  /// procedimento. Frontend mostra como titulo do card no Odontograma.
  title String?

  status      String    @default("DRAFT") // "DRAFT"|"SENT"|"ACCEPTED"|"REJECTED"|"EXPIRED"
  valid_until DateTime?

  /// Onda 6 — prioridade clinica definida pelo dentista na aba Avaliacao:
  /// "COMPLETO" (default, tratamento completo) | "ESSENCIAL" (importante) |
  /// "URGENTE" (urgencia). Recepcao usa pra priorizar fechamento.
  priority String?

  /// Onda 14.21 — Visibilidade na aba Propostas. Quando false, o quote
  /// some do scroll horizontal da aba Propostas mas continua intacto em
  /// Avaliacao/Orcamentos/Financeiro. Permite operador "limpar" a aba
  /// sem perder o orcamento. Default true (visivel). Botao de lixeira
  /// nos cards da aba Propostas seta este campo pra false.
  visible_in_proposals Boolean @default(true)

  /// Onda 14.26 — Define se parcelados desta venda exigem consulta de
  /// credito (Banco PASSOS / Serasa). Default true (rigoroso). Operador
  /// pode setar false pra clientes VIP / conhecidos / valores baixos —
  /// nesses casos parcelados aplicam direto sem credit-check, operador
  /// assume risco. Metadata de UI, nao bloqueia logica de cobranca.
  requires_credit_check Boolean @default(true)

  /// Onda 14.33 — Marca esta proposta como "ESCOLHIDA pra apresentar ao paciente".
  /// Quando true, a aba Propostas destaca este card e esmaece os demais
  /// (visual de "estamos esperando o paciente decidir SOBRE ESTA"). So uma
  /// proposta por paciente pode estar marcada por vez — o backend garante
  /// exclusividade quando alguem chama choose-as-proposal. Nao muda o
  /// status do Quote (continua DRAFT/SENT/ACCEPTED), e so um marcador
  /// de "destaque visual" pro fluxo de negociacao.
  is_chosen_proposal Boolean @default(false)

  /// Onda 14.38 — Forma de pagamento "salva" da proposta. Persistida quando
  /// o operador clica em "Salvar proposta" no painel — congela a oferta que
  /// foi apresentada (ex: "pix-avista", "cartao-6x", "parcelado-12x",
  /// "boleto-avista"). Null = sem oferta salva ainda.
  chosen_payment_key  String?

  /// Onda 18 — Desconto à vista OPCIONAL como gatilho de fechamento. Quando o
  /// operador liga o toggle na proposta, congela aqui: enabled + % aplicado
  /// (snapshot do TenantSetting DESCONTO_AVISTA_PCT no momento do save, default
  /// 10). Aplicado a TODAS as formas à vista (PIX/dinheiro/conta/maquineta/
  /// espécie e boleto à vista). Default false (cobra cheio).
  avista_discount_enabled Boolean  @default(false)
  avista_discount_pct     Decimal? @default(0) @db.Decimal(5, 2)

  /// Onda 14.38 — Valor de entrada (R$) configurado pelo operador quando
  /// salvou a proposta. Default 0 (sem entrada). Aplicavel pra cartao e
  /// boleto parcelado (PIX e Boleto a vista ignoram entrada).
  ///
  /// Onda 14.58 — Esse valor passou a representar o TOTAL da entrada (sinal
  /// + entrada). A divisao em duas etapas (sinal pago hoje + entrada pago
  /// num boleto futuro) vai nos campos abaixo. Quando chosen_signal_value=0
  /// e o comportamento legado: entrada unica paga junto com a 1a parcela.
  chosen_down_payment Decimal? @default(0) @db.Decimal(10, 2)

  /// Onda 14.58 — Sinal de fechamento. Parte da entrada que o paciente paga
  /// na hora do fechamento (R$). Default 0 = sem sinal (entrada unica).
  /// Cobrado via PIX ou Boleto a vista conforme chosen_signal_method.
  chosen_signal_value            Decimal?  @default(0) @db.Decimal(10, 2)
  /// Onda 14.58 — Metodo de pagamento do sinal: 'PIX' ou 'BOLETO'.
  /// Null = nao aplicavel (sem sinal). Operador escolhe na hora do
  /// fechamento (PIX gera link/QR imediato, Boleto vence hoje).
  chosen_signal_method           String?
  /// Onda 14.58 — Data de vencimento do boleto da entrada (resto apos
  /// sinal). Default null = imediato (mesmo dia do fechamento, comportamento
  /// legado). Quando configurado, eh quando o paciente deve pagar a entrada
  /// nao-sinal (geralmente fim do mes de fechamento).
  chosen_entrada_due_date        DateTime? @db.Date
  /// Onda 14.58 — Data de inicio das parcelas (1a parcela vence aqui).
  /// Default null = +30 dias da entrada (comportamento legado). Configuravel
  /// pelo operador quando quer dar mais folego ao paciente (ex: 60 dias).
  chosen_installments_start_date DateTime? @db.Date

  subtotal         Decimal @default(0) @db.Decimal(10, 2)
  discount_percent Decimal @default(0) @db.Decimal(5, 2)
  discount_value   Decimal @default(0) @db.Decimal(10, 2)
  total_value      Decimal @default(0) @db.Decimal(10, 2)

  payment_terms String? // "A vista", "10x sem juros"
  notes         String?

  sent_at          DateTime?
  accepted_at      DateTime?
  rejected_at      DateTime?
  rejection_reason String?

  // Onda 4.3 (Fase 25) — Metricas de envelope/engajamento WhatsApp.
  // Permite operadora ver "paciente leu? entrou no portal? quantas vezes?"
  // pra decidir se faz follow-up ou nao.
  // - whatsapp_message_id: id retornado pela Evolution API ao enviar — usado
  //   pra cruzar com webhook messages.update (read=true) e popular read_at
  // - whatsapp_read_at: momento que o paciente leu a mensagem no app
  //   (populado por webhook handler — TODO Onda 4.3b)
  // - portal_view_count: quantas vezes o magic link foi aberto (proxy de
  //   interesse — paciente que abre 5x ta considerando seriamente)
  // - portal_last_viewed_at: ultimo acesso (UI mostra "ha 3h" pra ajudar
  //   recepcao decidir momento de follow-up)
  whatsapp_message_id   String?
  whatsapp_read_at      DateTime?
  portal_view_count     Int       @default(0)
  portal_last_viewed_at DateTime?

  // Onda 2 (Fase 24) — Cupom aplicado
  coupon_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Onda 25.6 (Fase 25) — Soft delete: orcamentos deletados ficam recuperaveis
  // por 30 dias antes de hard delete via job. Reduz risco de perda acidental.
  deleted_at         DateTime?
  deleted_by_user_id String?
  deleted_by         User?     @relation("QuoteDeleter", fields: [deleted_by_user_id], references: [id], onDelete: SetNull)

  /// Onda 17.32.38 — Arquivamento manual pos-encaminhar-ao-financeiro.
  /// Quando uma proposta vira ACCEPTED, o sistema pergunta se quer arquivar
  /// as outras versoes em aberto (Urgente/Essencial nao escolhidas). Arquivados:
  ///   - somem da aba "Plano de tratamento" (PropostasTab filtra archived_at=null)
  ///   - aparecem em /atendimento/financeiro/orcamentos-arquivados
  ///   - validos por 30 dias (UI mostra tag "EXPIRADO" depois disso)
  archived_at         DateTime?
  archived_by_user_id String?
  archived_by         User?     @relation("QuoteArchiver", fields: [archived_by_user_id], references: [id], onDelete: SetNull)

  patient              Patient           @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  created_by           User              @relation("QuoteCreator", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  items                QuoteItem[]
  treatment_plan       TreatmentPlan?
  // Fase 8 — comissoes geradas pelos pagamentos deste orcamento
  commissions          Commission[]      @relation("CommissionQuote")
  // Fase 11 — parcelas geradas pela aprovacao deste orcamento
  installments         Installment[]     @relation("QuoteInstallments")
  // Onda 2 (Fase 24) — Cupom aplicado
  coupon               QuoteCoupon?      @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  // Onda 3 (Fase 24) — Anexos (fotos antes/depois, TCLE, exames, etc)
  attachments          QuoteAttachment[]
  // Onda 3b (Fase 24) — Versionamento + renegociacao
  versions             QuoteVersion[]
  /// Quando o orcamento foi criado como renegociacao de outro orcamento,
  /// guarda referencia ao "pai". Pega "v3 renegociado de v2 renegociado de v1"
  renegotiated_from_id String?
  renegotiated_from    Quote?            @relation("QuoteRenegotiation", fields: [renegotiated_from_id], references: [id], onDelete: SetNull)
  renegotiations       Quote[]           @relation("QuoteRenegotiation")

  // Onda 4.1 (Fase 25) — Aprovacao parcial:
  // Quando paciente aceita SO ALGUNS items de um orcamento SENT, criamos
  // um novo Quote ACCEPTED com os items selecionados + apontamos pra ele
  // via accepted_from_id. Original vira REJECTED com motivo automatico
  // ("Aprovacao parcial — itens nao selecionados podem virar novo orcamento").
  // Permite fechar venda parcial (60% > 0%) mantendo histórico do que
  // foi proposto vs aceito.
  accepted_from_id    String?
  accepted_from       Quote?  @relation("QuotePartialAcceptance", fields: [accepted_from_id], references: [id], onDelete: SetNull)
  partial_acceptances Quote[] @relation("QuotePartialAcceptance")

  // Onda 14.24 — Contrato vinculado (1:1). Criado depois que o quote vai
  // pra ACCEPTED, gate antes de gerar cobranca. Opcional (operador pode
  // pular pra valores baixos). Detalhes no model Contract.
  contract Contract?

  @@index([patient_id, status])
  @@index([status, valid_until])
  @@index([coupon_id])
  @@index([renegotiated_from_id])
  @@index([accepted_from_id])
  // Onda 25.6 — query rapida de "orcamentos deletados nos ultimos 30 dias"
  @@index([deleted_at])
  // Onda 17.32.38 — query rapida de orcamentos arquivados (lista no Financeiro)
  @@index([archived_at])
  // Onda 14.18 — index pra calcular MAX(quote_number) por tenant rapidamente
  @@index([quote_number])
}

/// Onda 3b (Fase 24) — Snapshot imutavel do estado do orcamento em momentos
/// chave (envio, aceitacao, rejeicao, renegociacao). Preserva valores de
/// quando o orcamento foi enviado, mesmo se items forem modificados depois
/// em DRAFT. Permite ver historico da negociacao.
///
/// snapshot inclui: subtotal, discount_*, total_value, payment_terms,
/// valid_until, coupon (se houver) e items completos com nomes de procedure
/// no momento (preserva mesmo se procedure for renomeada/removida).
model QuoteVersion {
  id             String   @id @default(uuid())
  quote_id       String
  /// Numero sequencial 1, 2, 3 dentro do mesmo orcamento. Nova versao
  /// sempre = max + 1.
  version_number Int
  /// Estado do quote no momento do snapshot.
  status         String
  /// Snapshot completo em JSON — items, totais, cupom, condicoes
  snapshot       Json
  /// Total no momento (denormalizado pra exibir na lista sem desserializar JSON)
  total_value    Decimal  @db.Decimal(10, 2)
  /// Trigger que originou a versao (SEND, ACCEPT, REJECT, RENEGOTIATE, MANUAL)
  trigger        String
  /// Nota livre do operador sobre essa versao
  change_note    String?
  created_at     DateTime @default(now())
  created_by_id  String

  quote      Quote @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  created_by User  @relation("QuoteVersionCreator", fields: [created_by_id], references: [id], onDelete: Restrict)

  @@unique([quote_id, version_number])
  @@index([quote_id, created_at])
}

/// Onda 3 (Fase 24) — Arquivos anexados a um orçamento.
/// Use cases:
///  - Foto antes/depois (estetica facial, smile design) — vende mais
///  - Exames (rx panorama, periapical) que justificam o tratamento
///  - TCLE pré-preenchido pra paciente assinar
///  - Carta de prevenção / orientações pós-procedimento
///  - Documentos auxiliares (laudo, autorização de plano, etc)
///
/// Storage: FileStorageService grava em quote-attachments/{id}.{ext}
model QuoteAttachment {
  id             String   @id @default(uuid())
  quote_id       String
  uploaded_by_id String
  /// Nome original do arquivo (preservado pra exibir e pra download)
  filename       String
  /// MIME type (image/jpeg, application/pdf, etc) — usado pra serve correto
  mime_type      String
  /// Tamanho em bytes — pra mostrar na UI e bloquear uploads grandes
  size_bytes     Int
  /// Caminho relativo no FileStorage (quote-attachments/{id}.{ext})
  file_path      String
  /// Categoria livre pra agrupar (ex: "Antes/Depois", "Exame", "TCLE")
  category       String?
  /// Descricao opcional do que e este anexo
  description    String?
  created_at     DateTime @default(now())

  quote       Quote @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  uploaded_by User  @relation("QuoteAttachmentUploader", fields: [uploaded_by_id], references: [id], onDelete: Restrict)

  @@index([quote_id, created_at])
}

// ============================================================================
// FASE 24 — Onda 2 — TEMPLATES DE ORÇAMENTO + CUPONS
// ============================================================================

/// Template de orcamento por especialidade — admin cria conjuntos pre-prontos
/// (ex: "Implante unitario", "Clareamento + 4 facetas") e operador clica
/// "Usar modelo" no novo orcamento pra puxar todos os items de uma vez.
model QuoteTemplate {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String // "Implante unitario completo"
  description String?
  specialty   String? // tag livre: "Implante", "Estetica", "Endodontia"
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  items  QuoteTemplateItem[]

  @@index([tenant_id, is_active])
}

model QuoteTemplateItem {
  id           String   @id @default(uuid())
  template_id  String
  procedure_id String
  quantity     Int      @default(1)
  // unit_price opcional — se setado, sobrescreve base_price do Procedure
  // ao usar o template; se NULL, usa base_price do Procedure no momento.
  unit_price   Decimal? @db.Decimal(10, 2)
  notes        String?
  order_index  Int      @default(0)

  template  QuoteTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  procedure Procedure     @relation(fields: [procedure_id], references: [id], onDelete: Restrict)

  @@index([template_id])
}

/// Cupom promocional — admin cria com codigo unico, % ou R$ fixo, validade,
/// limite de usos. Operador digita o codigo no orcamento e desconto eh
/// aplicado automaticamente. Audita uso (used_count incrementa).
model QuoteCoupon {
  id              String    @id @default(uuid())
  tenant_id       String
  code            String // "FRIEND15", "MARCO10" — case-insensitive
  description     String?
  // Tipo de desconto: PERCENT aplica % ao subtotal; FIXED desconta R$ fixo
  discount_type   String    @default("PERCENT") // PERCENT | FIXED
  discount_amount Decimal   @db.Decimal(10, 2) // 15 (=15%) OU 250.00 (=R$ 250 off)
  // Janela de validade
  valid_from      DateTime?
  valid_until     DateTime?
  // Controle de uso
  max_uses        Int? // null = ilimitado
  used_count      Int       @default(0)
  is_active       Boolean   @default(true)
  // Restricoes opcionais (futuro: minimum_order_value, applicable_specialties)
  min_order_value Decimal?  @db.Decimal(10, 2) // valor minimo do orcamento pra valer
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@unique([tenant_id, code])
  @@index([tenant_id, is_active])
  @@index([valid_until])
}

model QuoteItem {
  id           String  @id @default(uuid())
  quote_id     String
  procedure_id String
  tooth_fdi    String?

  quantity    Int     @default(1)
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)
  notes       String?
  order_index Int     @default(0)

  // Onda 3.2 (Fase 25) — dentista responsavel pelo procedimento.
  // Permite:
  //  - Calculo de comissao por dentista (quanto cada um gerou)
  //  - Agenda inteligente (so agendar Botox com dentista certificado)
  //  - Auditoria clinica (quem fez o que)
  // Opcional: orcamentos antigos ficam null. Se dentista for deletado,
  // SetNull pra preservar registro do orcamento.
  dentist_id String?

  // Onda 4.2 (Fase 25) — Pagamento POR PROCEDIMENTO.
  // Permite paciente fechar Botox no PIX (a vista 5% off) E Implante em
  // 12x cartao no MESMO orcamento. Antes era so 1 metodo no quote inteiro.
  // Esteticamente importante (Botox eh rapido + valor menor; Implante eh
  // longo + valor alto — clientes querem pagar de jeitos diferentes).
  // NULL = usa o pagamento default do quote (compat com orcamentos antigos).
  payment_method     String? // "PIX" | "CASH" | "CARD" | "INSTALLMENTS" | "BOLETO" | "TRANSFER"
  installments_count Int? // se payment_method = INSTALLMENTS, quantas vezes (1-24)

  // Onda 7.2 — Aprovacao parcial in-place. NULL = pendente (paciente nao
  // fechou esse procedimento ainda); com data = aprovado naquele momento.
  // Substitui o fluxo antigo que dividia em 2 quotes (um ACEITO + um
  // "Procedimento restante"). Agora tudo fica no MESMO quote: items
  // aprovados ficam visualmente inativos + ficam disponiveis pra historico,
  // pendentes podem ser aprovados depois (paciente volta proxima consulta).
  // Quote.status nao muda automaticamente — controlado por outras acoes
  // (enviar, marcar aceito tudo, expirar, etc).
  approved_at DateTime?

  quote     Quote     @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedure_id], references: [id], onDelete: Restrict)
  dentist   User?     @relation("QuoteItemDentist", fields: [dentist_id], references: [id], onDelete: SetNull)

  @@index([quote_id])
  @@index([dentist_id])
}

/// Onda 14.24 — Contrato vinculado a um Quote ACCEPTED. Gate entre
/// aprovacao da proposta e geracao de cobranca: operador NAO pode cobrar
/// se o contrato esta pendente (a nao ser que tenha sido pulado via
/// skipped=true pra valores baixos). Fase 1: status atualizados manualmente
/// pelo operador. Fase 2: integracao ClickSign + webhook.
///
/// Diferente do ContractSignature antigo (linha 1116) que era vinculado
/// a Lead+Conversation pro sistema legado de advocacia. Este e simples,
/// vinculado direto ao Quote pelo fluxo odontologico.
model Contract {
  id       String @id @default(uuid())
  quote_id String @unique

  /// Tipo de template aplicado, define o conteudo do contrato.
  /// "ORTODONTIA" | "IMPLANTE" | "CLINICO_BASICO" | "LENTES"
  template_type String

  /// Onda 14.30 — Documentos adicionais selecionados pra assinatura.
  /// Array JSON de strings. Cada string e um ID de documento extra que
  /// vai ser incluido no PDF junto com o contrato principal. Ex:
  /// ["TCLE", "USO_IMAGEM", "LGPD", "GARANTIA", "RESPONSAVEL_LEGAL"].
  /// Default empty — operador marca os checkboxes desejados antes de
  /// criar o contrato. Contrato principal (template_type) e sempre
  /// incluido independente desta lista.
  selected_documents Json @default("[]")

  /// Status do contrato:
  /// DRAFT — criado mas nao enviado ainda
  /// SENT — enviado pro paciente (aguardando assinatura)
  /// OPENED — paciente abriu o documento (sub-step antes de assinar)
  /// PATIENT_SIGNED — paciente assinou, falta a clinica
  /// SIGNED — totalmente assinado (paciente + clinica)
  /// EXPIRED — passou do prazo sem assinar
  /// CANCELLED — cancelado pelo operador
  status String @default("DRAFT")

  /// Onda 14.24 — Operador pode pular contrato pra valores baixos.
  /// Quando true: cobranca liberada sem assinatura. Default false.
  /// O valor do quote no momento da decisao fica em skipped_at_value pra audit.
  skipped        Boolean   @default(false)
  skipped_reason String?
  skipped_at     DateTime?

  /// Onda 14.24 (Fase 2) — id do documento no ClickSign quando integrado.
  /// Fase 1: null (gestao manual).
  clicksign_document_id String?
  /// URL pra assinar (paciente acessa via WhatsApp/email)
  signing_url           String?
  /// PDF gerado/assinado
  pdf_url               String?

  /// Timestamps das transicoes de status (audit + UI de sub-timeline)
  sent_at             DateTime?
  opened_at           DateTime?
  patient_signed_at   DateTime?
  clinic_signed_at    DateTime?
  signed_at           DateTime?
  expires_at          DateTime?
  cancelled_at        DateTime?
  cancellation_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  created_by_user_id String
  quote              Quote  @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  created_by         User   @relation("ContractCreator", fields: [created_by_user_id], references: [id], onDelete: Restrict)

  events ContractEvent[]

  @@index([status])
  @@index([clicksign_document_id])
}

/// Onda 14.24 — Eventos do contrato (sub-timeline mostrada no painel
/// "Proximos passos" da aba Propostas). Cada transicao de status cria
/// um evento. Permite mostrar historico granular ("documento gerado em
/// X", "enviado em Y", "paciente abriu em Z", etc).
model ContractEvent {
  id          String @id @default(uuid())
  contract_id String

  /// Tipo do evento:
  /// CREATED — documento gerado a partir do template
  /// SENT — enviado pro paciente
  /// OPENED — paciente abriu o documento
  /// PATIENT_SIGNED — paciente assinou
  /// CLINIC_SIGNED — clinica (dentista) assinou
  /// EXPIRED — passou do prazo sem assinar
  /// CANCELLED — operador cancelou
  /// REMINDER_SENT — lembrete reenviado
  /// SKIPPED — operador pulou o contrato
  event_type String

  /// Texto descritivo do evento (preenchido pelo handler).
  description String?

  /// Usuario que disparou (null se foi automatico/webhook)
  triggered_by_user_id String?

  occurred_at DateTime @default(now())

  contract     Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  triggered_by User?    @relation("ContractEventTrigger", fields: [triggered_by_user_id], references: [id], onDelete: SetNull)

  @@index([contract_id, occurred_at])
}

model TreatmentPlan {
  id         String  @id @default(uuid())
  patient_id String
  quote_id   String? @unique

  status String @default("PENDING_SIGNATURE") // "PENDING_SIGNATURE"|"ACTIVE"|"PAUSED"|"COMPLETED"|"CANCELLED"

  /// Onda 14.59 — Status DA NEGOCIACAO (separado do status execucional acima).
  /// DRAFT (default) -> AWAITING_DOWN_PAYMENT (operador emitiu cobranca de
  /// entrada+sinal) -> APPROVED (entrada confirmada, parcelas geradas) ->
  /// COMPLETED (todos pagamentos liquidados).
  proposal_status String @default("DRAFT") // DRAFT|AWAITING_DOWN_PAYMENT|APPROVED|COMPLETED

  /// Onda 14.59 — Toggle por proposta: quando enviar ClickSign automaticamente.
  /// BEFORE = envia junto da cobranca de entrada. AFTER = envia quando entrada
  /// for confirmada. null = manual (operador dispara via botao separado).
  clicksign_send_timing String? // BEFORE|AFTER|null

  /// Onda 14.59 — Timestamp da emissao das cobrancas da entrada (idempotencia
  /// + auditoria de quando o ciclo de cobranca comecou).
  down_payment_emitted_at DateTime?

  /// Onda 14.59 — Timestamp da geracao automatica das parcelas apos confirmar
  /// entrada. Idempotente: se preenchido, trigger nao gera de novo.
  installments_generated_at DateTime?

  /// Onda 17.72 — Gate financeiro: o dentista só confirma os procedimentos DEPOIS
  /// que o Financeiro clicar "Validar" (libera o tratamento). null = aguardando validação.
  validated_by_financial_at DateTime?
  validated_by_financial_id String?

  start_date         DateTime?
  end_date           DateTime?
  estimated_sessions Int?
  total_value        Decimal   @default(0) @db.Decimal(10, 2)

  /// ClickSign — plano so fica ACTIVE apos assinatura
  contract_signature_id String? @unique

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient            Patient                @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  quote              Quote?                 @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  contract_signature ContractSignature?     @relation(fields: [contract_signature_id], references: [id], onDelete: SetNull)
  items              TreatmentPlanItem[]
  consents           ConsentRecord[]
  /// Onda 14.59 — charges (sinal+entrada+parcelas) vinculadas a este plan
  charges            PaymentGatewayCharge[]

  @@index([patient_id, status])
  @@index([status])
  @@index([proposal_status])
}

model TreatmentPlanItem {
  id                String  @id @default(uuid())
  treatment_plan_id String
  procedure_id      String
  tooth_fdi         String?

  quantity    Int     @default(1)
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)

  status String @default("PENDING") // "PENDING"|"SCHEDULED"|"IN_PROGRESS"|"DONE"|"CANCELLED"

  scheduled_at             DateTime?
  scheduled_appointment_id String?

  executed_at         DateTime?
  executed_by_user_id String?

  notes       String?
  order_index Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  treatment_plan        TreatmentPlan         @relation(fields: [treatment_plan_id], references: [id], onDelete: Cascade)
  procedure             Procedure             @relation(fields: [procedure_id], references: [id], onDelete: Restrict)
  scheduled_appointment CalendarEvent?        @relation("TreatmentPlanItemAppointment", fields: [scheduled_appointment_id], references: [id], onDelete: SetNull)
  executed_by           User?                 @relation("TreatmentPlanItemExecutor", fields: [executed_by_user_id], references: [id], onDelete: SetNull)
  esthetic_applications EstheticApplication[]
  // Fase 8 — comissao gerada por execucao deste item
  commissions           Commission[]          @relation("CommissionTreatmentItem")
  // Onda 5 (Fase 25) — manutencao gerada quando item vira DONE (se procedure
  // tem default_revisit_months definido)
  maintenance_tasks     MaintenanceTask[]     @relation("TPItemMaintenance")

  @@index([treatment_plan_id, status])
  @@index([scheduled_appointment_id])
  @@index([executed_by_user_id])
}

// ============================================================================
// FASE 6 — ESTETICA FACIAL AVANCADA + ESTOQUE COM RASTREABILIDADE ANVISA
// ============================================================================
//
// Cobre toxina botulinica, acido hialuronico, bioestimuladores, fios de
// PDO/PLLA, peelings quimicos, microagulhamento, skinboosters, laser,
// radiofrequencia, ultrassom microfocado, lipo enzimatica.
//
// Conformidade:
// - ANVISA: rastreabilidade obrigatoria de lote/validade para injetaveis
//   (RDC 751/2022 e correlatas)
// - CFO Resolucao 230/2020: HOF e especialidade odontologica reconhecida
// - Reacao adversa pode ser notificada via NOTIVISA
//
// Mapa facial: 30 pontos padronizados (frontal, glabela, pe-de-galinha,
// nasolabial, etc.) — armazenados como string para flexibilidade.

// ============================================================================
// ESTOQUE — Supplier + Product + StockMovement + ProcedureConsumable
// ============================================================================

/// Fornecedor (laboratorio de protese, distribuidora de insumos, etc.).
model Supplier {
  id           String   @id @default(uuid())
  tenant_id    String
  name         String
  cnpj         String?
  category     String? // "LABORATORIO" | "INSUMOS" | "EQUIPAMENTOS" | "SERVICOS" | "OUTRO"
  contact_name String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products  Product[]
  movements StockMovement[]

  @@index([tenant_id, active])
  @@index([tenant_id, name])
}

/// Produto de estoque (insumo odontologico ou injetavel estetico).
///
/// Para injetaveis (toxina botulinica, acido hialuronico, bioestimuladores,
/// fios), `requires_lot_tracking` deve ser true — exigencia regulatoria
/// ANVISA para rastreabilidade caso ocorra reacao adversa ou recall.
/// Cada EstheticApplication referencia o lote utilizado.
model Product {
  id          String  @id @default(uuid())
  tenant_id   String
  supplier_id String?

  name    String
  brand   String? // Marca comercial (Allergan, Juvederm, Sculptra…)
  sku     String?
  barcode String?

  /// Categorias suportadas:
  /// Odonto:    "ANESTESICO" | "RESINA" | "BRACKETS" | "EQUIPAMENTO" | "DESCARTAVEL"
  /// Estetica:  "TOXINA_BOTULINICA" | "ACIDO_HIALURONICO" | "BIOESTIMULADOR"
  ///            "FIO_PDO" | "FIO_PLLA" | "ENZIMA" | "PEELING_QUIMICO"
  ///            "SKINBOOSTER" | "ANESTESICO_TOPICO" | "COSMETICO"
  category    String?
  unit        String  @default("UN") // "UN" | "ML" | "MG" | "UI" | "CAIXA" | "KIT"
  description String?

  // Regulatorio (ANVISA)
  anvisa_registration   String? // No de registro ANVISA
  is_injectable         Boolean @default(false) // Aplicacao injetavel (regra mais rigida)
  is_controlled         Boolean @default(false) // Substancia controlada
  requires_lot_tracking Boolean @default(false) // Lote obrigatorio por aplicacao

  // Estoque
  current_stock Decimal  @default(0) @db.Decimal(10, 3)
  min_stock     Decimal? @db.Decimal(10, 3) // Alerta de reposicao
  max_stock     Decimal? @db.Decimal(10, 3)

  // Preco
  cost_price Decimal? @db.Decimal(10, 2) // Custo (para margem)
  sale_price Decimal? @db.Decimal(10, 2) // Venda avulsa (se aplicavel)

  has_expiration Boolean @default(false)

  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant                Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier              Supplier?             @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  movements             StockMovement[]
  consumables           ProcedureConsumable[]
  esthetic_applications EstheticApplication[]

  @@unique([tenant_id, sku])
  @@index([tenant_id, name])
  @@index([tenant_id, category])
  @@index([anvisa_registration])
  @@index([active])
}

/// Movimento de estoque: entrada de compra, saida por procedimento,
/// ajuste manual, descarte por vencimento.
model StockMovement {
  id          String  @id @default(uuid())
  tenant_id   String
  product_id  String
  supplier_id String?

  type       String // "ENTRADA" | "SAIDA" | "AJUSTE" | "DESCARTE_VENCIMENTO" | "PERDA"
  quantity   Decimal  @db.Decimal(10, 3) // Sempre positiva — type define direcao
  unit_cost  Decimal? @db.Decimal(10, 2)
  total_cost Decimal? @db.Decimal(10, 2)

  // Lote/validade (obrigatorios quando product.requires_lot_tracking = true)
  batch_number    String?
  expiration_date DateTime?

  // Vinculos
  appointment_id       String? // Saida ligada a um atendimento
  notes                String?
  performed_by_user_id String?
  performed_at         DateTime @default(now())
  created_at           DateTime @default(now())

  tenant       Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  supplier     Supplier?      @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  appointment  CalendarEvent? @relation("AppointmentStockMovements", fields: [appointment_id], references: [id], onDelete: SetNull)
  performed_by User?          @relation("StockMover", fields: [performed_by_user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, product_id])
  @@index([type, performed_at])
  @@index([batch_number])
  @@index([expiration_date])
}

/// Vinculo procedimento <-> insumo. Permite baixa automatica do estoque
/// ao executar um procedimento e calculo do custo real.
model ProcedureConsumable {
  id           String   @id @default(uuid())
  procedure_id String
  product_id   String
  quantity     Decimal  @db.Decimal(10, 3) // Quantidade consumida por execucao
  notes        String?
  created_at   DateTime @default(now())

  procedure Procedure @relation(fields: [procedure_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([procedure_id, product_id])
  @@index([product_id])
}

// ============================================================================
// ESTETICA FACIAL — EstheticApplication (mapa de 30 pontos + lote)
// ============================================================================

/// Aplicacao de procedimento estetico em ponto facial especifico.
/// Cada aplicacao registra produto + lote + volume + ponto + tecnica,
/// gerando rastreabilidade ANVISA e historico para o paciente.
///
/// Pontos faciais padronizados (campo `application_point`):
///   FRONTAL, GLABELA, PE_DE_GALINHA_DIR, PE_DE_GALINHA_ESQ,
///   SUPRACILIAR_DIR, SUPRACILIAR_ESQ, NASAL_DORSO, PONTA_NASAL,
///   BUNNY_LINES, MENTO, MASSETER_DIR, MASSETER_ESQ,
///   NASOLABIAL_DIR, NASOLABIAL_ESQ, MARIONETE_DIR, MARIONETE_ESQ,
///   LABIO_SUPERIOR, LABIO_INFERIOR, COMISSURA_DIR, COMISSURA_ESQ,
///   MALAR_DIR, MALAR_ESQ, MANDIBULA_DIR, MANDIBULA_ESQ,
///   PESCOCO, PLATISMA, COLO, TEMPORAL_DIR, TEMPORAL_ESQ, OUTRO
model EstheticApplication {
  id         String @id @default(uuid())
  tenant_id  String
  patient_id String

  // Vinculos opcionais
  procedure_id           String? // Procedimento do catalogo
  clinical_note_id       String? // Nota SOAP que registrou
  appointment_id         String? // Consulta em que foi executado
  treatment_plan_item_id String? // Item do plano de tratamento

  // Anatomia facial
  application_point String // ver lista acima
  side              String? // "DIREITA" | "ESQUERDA" | "BILATERAL" | "CENTRAL"

  // Produto aplicado (rastreabilidade ANVISA)
  product_id            String?
  product_name_snapshot String? // Snapshot — produto pode ser descontinuado
  brand_snapshot        String? // Marca no momento da aplicacao
  batch_number          String? // LOTE — obrigatorio para injetaveis
  expiration_date       DateTime? // Validade do lote usado

  // Quantidade
  volume       Decimal? @db.Decimal(10, 3) // mL ou UI
  unit         String? // "ML" | "UI" | "MG"
  dilution     String? // Ex: "100UI/2mL"
  needle_gauge String? // Ex: "30G", "27G"

  // Tecnica
  technique String? // "BOLUS" | "RETROINJECAO" | "FANNING" | "CROSSHATCH" | "MAP" | "ROLAMENTO" | "OUTRO"
  depth     String? // "SUPERFICIAL" | "MEDIO" | "PROFUNDO" | "SUPRAPERIOSTAL" | "SUBDERMICO"

  notes String?

  // Validade do efeito (gera lembrete de retorno automatico)
  expected_duration_months Int? // Ex: AH=12-18, Botox=4-6, Sculptra=24
  expected_revisit_at      DateTime? // Calculado: applied_at + duration

  applied_by_user_id String
  applied_at         DateTime @default(now())
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tenant              Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient             Patient            @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  procedure           Procedure?         @relation(fields: [procedure_id], references: [id], onDelete: SetNull)
  clinical_note       ClinicalNote?      @relation("ClinicalNoteEstheticApplications", fields: [clinical_note_id], references: [id], onDelete: SetNull)
  appointment         CalendarEvent?     @relation("AppointmentEstheticApplications", fields: [appointment_id], references: [id], onDelete: SetNull)
  treatment_plan_item TreatmentPlanItem? @relation(fields: [treatment_plan_item_id], references: [id], onDelete: SetNull)
  product             Product?           @relation(fields: [product_id], references: [id], onDelete: SetNull)
  applied_by          User               @relation("EstheticApplicator", fields: [applied_by_user_id], references: [id], onDelete: Restrict)
  adverse_reactions   AdverseReaction[]
  // Onda 5 (Fase 25) — manutencao auto-gerada a partir desta aplicacao
  maintenance_tasks   MaintenanceTask[]

  @@index([tenant_id, patient_id])
  @@index([patient_id, applied_at])
  @@index([batch_number]) // Rastreabilidade reversa: dado um lote, quem usou?
  @@index([product_id])
  @@index([expected_revisit_at])
}

// ============================================================================
// MANUTENCAO / RECALL (Fase 25 Onda 5)
// ============================================================================

/// Task de manutencao/revisita pos-procedimento.
///
/// Origens (3 caminhos pra criar):
///   1. AUTO via EstheticApplication: ao registrar aplicacao com
///      expected_revisit_at, gera task pra essa data
///   2. AUTO via TreatmentPlanItem DONE: se procedure.default_revisit_months
///      definido, cria task pra applied_at + N meses
///   3. MANUAL: operadora cria via UI sem vincular a procedimento especifico
///
/// Worker BullMQ (cron diario) processa tasks com due_date em 7 dias e
/// reminder_sent_at NULL: envia WhatsApp pro paciente "Sua revisao de Botox
/// esta chegando! Posso agendar?".
///
/// Status workflow:
///   PENDING (criada, aguardando) -> SCHEDULED (operadora agendou consulta)
///                                -> DONE (revisita realizada — completed_at)
///                                -> MISSED (data passou sem agendamento)
///                                -> CANCELLED (paciente cancelou explicitamente)
model MaintenanceTask {
  id         String @id @default(uuid())
  tenant_id  String
  patient_id String

  // Origens (todas opcionais — ao menos uma deve estar preenchida ou eh manual)
  procedure_id            String? // procedimento que originou (catalogo)
  treatment_plan_item_id  String? // se veio de plano de tratamento
  esthetic_application_id String? // se veio de aplicacao estetica
  scheduled_event_id      String? // CalendarEvent criado quando operadora agenda

  // Datas
  due_date     DateTime // quando fazer a revisita
  completed_at DateTime?

  // Status workflow
  status String @default("PENDING") // PENDING | SCHEDULED | DONE | MISSED | CANCELLED

  // Detalhes pra UI/WhatsApp
  title String // ex: "Revisão de Botox glabela"
  notes String?

  // Tracking de notificacao WhatsApp (worker preenche)
  reminder_sent_at    DateTime? // quando enviou o lembrete 7d antes
  reminder_message_id String? // id Evolution pra cruzar com webhook

  completed_by_user_id String?
  created_by_user_id   String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  tenant               Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient              Patient              @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  procedure            Procedure?           @relation(fields: [procedure_id], references: [id], onDelete: SetNull)
  treatment_plan_item  TreatmentPlanItem?   @relation("TPItemMaintenance", fields: [treatment_plan_item_id], references: [id], onDelete: SetNull)
  esthetic_application EstheticApplication? @relation(fields: [esthetic_application_id], references: [id], onDelete: SetNull)
  scheduled_event      CalendarEvent?       @relation("MaintenanceTaskEvent", fields: [scheduled_event_id], references: [id], onDelete: SetNull)
  completed_by         User?                @relation("MaintenanceTaskCompletedBy", fields: [completed_by_user_id], references: [id], onDelete: SetNull)
  created_by           User?                @relation("MaintenanceTaskCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  // Indexes pra queries comuns:
  @@index([tenant_id, due_date]) // dashboard "atrasadas/proximas no tenant"
  @@index([patient_id, status]) // tab manutencoes do paciente
  @@index([status, due_date]) // worker cron: WHERE status=PENDING AND due_date < +7d
  @@index([reminder_sent_at]) // worker: evita reenviar lembrete
  @@index([esthetic_application_id])
  @@index([treatment_plan_item_id])
}

// ============================================================================
// REACAO ADVERSA — registro clinico + base para NOTIVISA/ANVISA
// ============================================================================

/// Registro de reacao adversa pos-aplicacao estetica/odontologica.
/// Obrigacao etico-legal do profissional. Permite alimentar base para
/// eventual notificacao via NOTIVISA/ANVISA.
model AdverseReaction {
  id                      String  @id @default(uuid())
  tenant_id               String
  patient_id              String
  esthetic_application_id String?
  procedure_id            String?

  severity      String // "LEVE" | "MODERADA" | "GRAVE" | "AMEACA_VIDA"
  reaction_type String // "EDEMA" | "EQUIMOSE" | "NODULO" | "INFECCAO" | "NECROSE" | "ALERGIA" | "ASSIMETRIA" | "MIGRACAO" | "EMBOLIA" | "OUTRO"

  description      String
  onset_at         DateTime // Inicio dos sintomas
  resolved_at      DateTime?
  resolution_notes String?

  // Conduta
  treatment_given String? // Hialuronidase, antibiotico, corticoide, observacao…
  hospitalized    Boolean @default(false)

  // Notificacao regulatoria
  notivisa_reported    Boolean   @default(false)
  notivisa_reported_at DateTime?
  notivisa_protocol    String?

  reported_by_user_id String
  reported_at         DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  tenant               Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient              Patient              @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  esthetic_application EstheticApplication? @relation(fields: [esthetic_application_id], references: [id], onDelete: SetNull)
  procedure            Procedure?           @relation("ProcedureAdverseReactions", fields: [procedure_id], references: [id], onDelete: SetNull)
  reported_by          User                 @relation("AdverseReactionReporter", fields: [reported_by_user_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, patient_id])
  @@index([severity])
  @@index([esthetic_application_id])
  @@index([reported_at])
}

// ============================================================================
// FASE 7 — AGENDA EVOLUIDA (multi-recurso, marcadores, confirmacao, retorno)
// ============================================================================
//
// Adiciona ao modulo de agenda:
//  - Sala/cadeira como recurso fisico reservavel (Room)
//  - Marcadores (tags) reutilizaveis aplicados a agendamentos
//  - Confirmacao por canal (auditavel)
//  - Alerta de retorno programado (carro-chefe Clinicorp)
//
// CalendarEvent ganha room_id (nullable) — eventos antigos continuam validos.
// Cores semanticas (cinza/branco/rosa/vermelho) sao calculadas no front-end
// a partir dos campos status + start_at/end_at, nao precisam de coluna nova.

// ============================================================================
// Room — sala/cadeira
// ============================================================================

/// Recurso fisico (cadeira odontologica, sala de cirurgia, sala de HOF).
/// Permite agenda multi-recurso (profissional × cadeira) e detectar
/// conflitos de sala alem de conflitos de profissional.
model Room {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String // "Cadeira 1", "Sala de Cirurgia", "Sala HOF"
  description String?
  color       String? // Cor hex para destaque na agenda (#FF6A1A)
  capacity    Int      @default(1) // Quantos pacientes simultaneos a sala suporta
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  appointments CalendarEvent[] @relation("AppointmentRoom")

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
}

// ============================================================================
// AppointmentMarker — tags reutilizaveis para agendamentos
// ============================================================================

/// Marcador (tag) aplicavel a agendamento: "Indicacao", "VIP", "Plano X",
/// "Retorno 6 meses", "Primeira consulta", etc. Geram relatorios filtrados.
model AppointmentMarker {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  color      String? // Hex para badge na UI (#28A745)
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant      Tenant                        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  assignments AppointmentMarkerAssignment[]

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
}

/// Pivot N:N entre CalendarEvent e AppointmentMarker.
model AppointmentMarkerAssignment {
  id             String   @id @default(uuid())
  appointment_id String
  marker_id      String
  created_at     DateTime @default(now())

  appointment CalendarEvent     @relation("AppointmentMarkers", fields: [appointment_id], references: [id], onDelete: Cascade)
  marker      AppointmentMarker @relation(fields: [marker_id], references: [id], onDelete: Cascade)

  @@unique([appointment_id, marker_id])
  @@index([marker_id])
}

// ============================================================================
// AppointmentConfirmation — tentativa de confirmacao auditavel por canal
// ============================================================================

/// Cada disparo de confirmacao (WhatsApp/SMS/email/app/manual) gera um
/// registro proprio com timestamp, mensagem enviada, canal e resposta do
/// paciente. Substitui flag binaria "confirmou/nao confirmou" — permite
/// auditoria completa e contagem de tentativas por canal.
model AppointmentConfirmation {
  id              String    @id @default(uuid())
  appointment_id  String
  channel         String // "WHATSAPP" | "SMS" | "EMAIL" | "APP_PUSH" | "CLOUDIA" | "MANUAL"
  scheduled_for   DateTime? // Quando deveria sair (ex: 24h antes)
  sent_at         DateTime?
  message_text    String?
  // Resposta do paciente
  response_status String    @default("PENDENTE") // "PENDENTE" | "CONFIRMADO" | "REJEITADO" | "REMARCADO" | "SEM_RESPOSTA"
  response_at     DateTime?
  response_text   String?
  // Vinculo opcional ao Message do WhatsApp recebido
  message_id      String?
  delivery_status String? // "SENT" | "DELIVERED" | "READ" | "FAILED"
  created_at      DateTime  @default(now())

  appointment CalendarEvent @relation("AppointmentConfirmations", fields: [appointment_id], references: [id], onDelete: Cascade)

  @@index([appointment_id, channel])
  @@index([response_status])
  @@index([scheduled_for])
}

// ============================================================================
// ReturnAlert — alerta de retorno programado (carro-chefe Clinicorp)
// ============================================================================

/// Ao final de um atendimento, o profissional programa um alerta de retorno
/// ("voltar em 6 meses para revisao", "refinamento alinhador em 90 dias",
/// "retorno HOF em 4 meses"). Quando chega scheduled_for, vira tarefa da
/// recepcao para reagendar — gera receita recorrente com pacientes que
/// "somem depois do primeiro atendimento".
model ReturnAlert {
  id                       String    @id @default(uuid())
  tenant_id                String
  patient_id               String
  professional_user_id     String?
  source_appointment_id    String? // Consulta que originou o alerta
  // Alvo
  scheduled_for            DateTime // Quando entra na lista da recepcao
  reason                   String? // "Retorno limpeza 6m", "Refinamento alinhador", etc.
  notes                    String?
  // Status
  status                   String    @default("PENDENTE") // "PENDENTE" | "CONTATADO" | "AGENDADO" | "REJEITADO" | "EXPIRADO"
  contacted_at             DateTime?
  contacted_by_user_id     String?
  scheduled_appointment_id String? // Se gerou novo agendamento
  // Timestamps
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  tenant                Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient               Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  professional          User?          @relation("ReturnAlertProfessional", fields: [professional_user_id], references: [id], onDelete: SetNull)
  contacted_by          User?          @relation("ReturnAlertContact", fields: [contacted_by_user_id], references: [id], onDelete: SetNull)
  source_appointment    CalendarEvent? @relation("AppointmentSourceAlerts", fields: [source_appointment_id], references: [id], onDelete: SetNull)
  scheduled_appointment CalendarEvent? @relation("AppointmentScheduledByAlert", fields: [scheduled_appointment_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, scheduled_for])
  @@index([patient_id])
  @@index([status, scheduled_for])
  @@index([professional_user_id])
}

// ============================================================================
// FASE 8 — COMISSOES + METAS
// ============================================================================
//
// Comissoes:
//  - CommissionRule define regra (% ou fixo, por profissional/procedimento/
//    categoria) com prioridade implicita por especificidade.
//  - Commission e a comissao gerada por execucao — transita DEVIDA -> DISPONIVEL
//    (quando paciente paga) -> PAGA (quando clinica liquida com profissional).
//  - Trigger configuravel: ON_EXECUTION (libera ja na execucao) ou ON_PAYMENT
//    (so libera quando paciente paga — modelo Clinicorp, alinha incentivo).
//
// Metas:
//  - Goal com tipo (vendas/primeiras consultas/ocupacao/faltas), escopo
//    (clinica ou profissional), direcao (atingir vs nao ultrapassar), periodo.
//  - Cache current_value + projected_value (preenchido por job cron).

// ============================================================================
// CommissionRule — regra de comissao configuravel
// ============================================================================

model CommissionRule {
  id                   String @id @default(uuid())
  tenant_id            String
  professional_user_id String

  // Escopo (todos opcionais — quanto mais especifico, maior prioridade)
  procedure_id       String?
  procedure_category String?

  // Valor (use percentage OU fixed_value, nao ambos)
  percentage  Decimal? @db.Decimal(5, 2) // % sobre valor pago
  fixed_value Decimal? @db.Decimal(10, 2) // R$ fixo por execucao

  // Quando libera comissao (Clinicorp libera no recebimento)
  trigger String @default("ON_PAYMENT") // "ON_EXECUTION" | "ON_PAYMENT"

  // Vigencia
  active    Boolean   @default(true)
  starts_at DateTime?
  ends_at   DateTime?

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  professional User   @relation("CommissionRuleProfessional", fields: [professional_user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, professional_user_id])
  @@index([active])
}

// ============================================================================
// Commission — comissao gerada por execucao
// ============================================================================

model Commission {
  id                   String  @id @default(uuid())
  tenant_id            String
  professional_user_id String
  patient_id           String
  procedure_id         String?

  // Vinculo opcional ao item de plano executado
  treatment_plan_item_id String?
  // Vinculo opcional ao orcamento/pagamento que liberou
  quote_id               String?

  // Onda 17.67 — tipo da comissao: 'EXECUCAO' (padrao, gerada na execucao do item) | 'VENDA' (gerada no fechamento da venda)
  kind String @default("EXECUCAO")

  // Valor base e calculado
  base_value  Decimal  @db.Decimal(10, 2)
  percentage  Decimal? @db.Decimal(5, 2)
  fixed_value Decimal? @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)

  // Status / fluxo
  status         String    @default("DEVIDA") // "DEVIDA" | "DISPONIVEL" | "PAGA" | "CANCELADA"
  available_at   DateTime?
  paid_at        DateTime?
  payment_method String? // PIX, TRANSFERENCIA, DINHEIRO

  reference_month String? // "2026-04" para agrupar mensalmente
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant              Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  professional        User               @relation("CommissionRecipient", fields: [professional_user_id], references: [id])
  patient             Patient            @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  procedure           Procedure?         @relation("CommissionProcedure", fields: [procedure_id], references: [id], onDelete: SetNull)
  treatment_plan_item TreatmentPlanItem? @relation("CommissionTreatmentItem", fields: [treatment_plan_item_id], references: [id], onDelete: SetNull)
  quote               Quote?             @relation("CommissionQuote", fields: [quote_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, professional_user_id, reference_month])
  @@index([status])
  @@index([available_at])
}

// ============================================================================
// Goal — meta com projecao
// ============================================================================

model Goal {
  id        String @id @default(uuid())
  tenant_id String

  // Tipo de meta
  metric String // "SALES_VALUE" | "FIRST_CONSULTATIONS" | "MISSES_PCT" | "OCCUPATION_PCT" | "NEW_PATIENTS" | "CONVERSIONS" | "CUSTOM"

  // Escopo
  scope                String  @default("CLINIC") // "CLINIC" | "PROFESSIONAL"
  professional_user_id String?

  // Direcao (atingir vs nao ultrapassar)
  direction    String  @default("ACHIEVE") // "ACHIEVE" (vendas) | "LIMIT" (faltas)
  target_value Decimal @db.Decimal(12, 2)

  // Periodo
  period_type  String   @default("MONTHLY") // "DAILY" | "WEEKLY" | "MONTHLY" | "QUARTERLY" | "YEARLY" | "CUSTOM"
  period_start DateTime
  period_end   DateTime

  // Cache (preenchido por job cron)
  current_value      Decimal?  @default(0) @db.Decimal(12, 2)
  projected_value    Decimal?  @db.Decimal(12, 2) // "no ritmo atual"
  last_calculated_at DateTime?

  // Status
  active     Boolean  @default(true)
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  professional User?  @relation("GoalProfessional", fields: [professional_user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, period_start])
  @@index([metric, active])
  @@index([professional_user_id])
}

// ============================================================================
// FASE 11 — REGUA DE COBRANCA (Installment + CollectionAttempt)
// ============================================================================

model Installment {
  id         String  @id @default(uuid())
  tenant_id  String
  patient_id String
  // Origem (qual orcamento gerou)
  quote_id   String?

  // Posicao
  sequence    Int @default(1)
  total_count Int @default(1)

  // Valores
  amount         Decimal @db.Decimal(10, 2)
  amount_paid    Decimal @default(0) @db.Decimal(10, 2)
  discount_value Decimal @default(0) @db.Decimal(10, 2)
  fee_value      Decimal @default(0) @db.Decimal(10, 2) // juros/multa por atraso

  // Datas
  due_date DateTime
  paid_at  DateTime?

  // Pagamento
  payment_method String? // PIX | BOLETO | CARTAO | DINHEIRO | TRANSFERENCIA | MAQUININHA
  status         String  @default("ABERTA") // ABERTA | PAGA | PARCIAL | ATRASADA | CANCELADA | RENEGOCIADA

  // Vinculos opcionais
  gateway_charge_id  String? @unique
  nota_fiscal_id     String? @unique
  renegotiated_to_id String?

  // Estado da regua de cobranca
  collection_stage   String? // PRE_DUE_3D | DUE_DAY | D_PLUS_1 | D_PLUS_7 | D_PLUS_15 | D_PLUS_30
  last_collection_at DateTime?

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant              Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient             Patient               @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  quote               Quote?                @relation("QuoteInstallments", fields: [quote_id], references: [id], onDelete: SetNull)
  renegotiated_to     Installment?          @relation("InstallmentRenegotiation", fields: [renegotiated_to_id], references: [id], onDelete: SetNull)
  renegotiated_from   Installment[]         @relation("InstallmentRenegotiation")
  collection_attempts CollectionAttempt[]
  // Fase 18 — cobranca via gateway (Asaas/Iugu/etc)
  payment_charge      PaymentGatewayCharge?

  @@index([tenant_id, due_date])
  @@index([patient_id, status])
  @@index([status, due_date])
  @@index([quote_id, sequence])
  @@index([gateway_charge_id])
}

model CollectionAttempt {
  id             String @id @default(uuid())
  installment_id String

  stage   String // PRE_DUE_3D | DUE_DAY | D_PLUS_1 | D_PLUS_7 | D_PLUS_15 | D_PLUS_30
  channel String // WHATSAPP | SMS | EMAIL | LIGACAO | APP_PUSH

  message_text    String?
  sent_at         DateTime @default(now())
  delivery_status String? // SENT | DELIVERED | READ | FAILED | BOUNCED

  response_at   DateTime?
  response_text String?
  message_id    String?

  installment Installment @relation(fields: [installment_id], references: [id], onDelete: Cascade)

  @@index([installment_id, stage])
  @@index([sent_at])
  @@index([delivery_status])
}

// ============================================================================
// FASE 13 — PORTAL DO PACIENTE (PWA)
// ============================================================================
//
// Login magico: recepcao gera token unico via API, dispara WhatsApp com
// link contendo o token. Paciente clica no link, valida o token, ganha
// JWT proprio e acessa o portal.
//
// PortalToken: uso unico para troca por JWT. Expira em 7 dias.

model PortalToken {
  id          String    @id @default(uuid())
  tenant_id   String
  patient_id  String
  // Token aleatorio (sera incluido no link enviado por WhatsApp)
  token       String    @unique
  // Quando ja foi usado (1x apenas — gera JWT e marca consumido)
  consumed_at DateTime?
  // Validade (default created_at + 7 dias)
  expires_at  DateTime
  // Metadados
  ip_address  String?
  user_agent  String?
  channel     String    @default("WHATSAPP") // WHATSAPP | EMAIL | SMS | MANUAL
  created_at  DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, patient_id])
  @@index([token])
  @@index([expires_at])
}

// ============================================================================
// FASE 15 — MULTI-UNIDADE / FRANQUIAS (Enterprise)
// ============================================================================
//
// Clinic representa uma sub-unidade dentro do tenant (rede ou franquia).
// Para franquias com tenant proprio, Clinic e overlay opcional.
//
// UserClinic e relacao N:N: um usuario pode ter acesso a multiplas
// unidades, com role/permissoes configuradas por unidade.
//
// Patient/CalendarEvent/Quote/Installment NAO ganham clinic_id nesta fase
// (refator gigante). Esta fase entrega cadastro + ranking comparativo
// agregado via tenant_id (cada Clinic pode ser tag para futura migration).

model Clinic {
  id                       String  @id @default(uuid())
  tenant_id                String
  name                     String
  short_name               String? // "Centro SP", "Moema", "Copacabana RJ"
  address                  String?
  city                     String?
  state                    String? // UF
  phone                    String?
  email                    String?
  cnpj                     String?
  // Tipo (Clinicorp distingue dental vs aesthetic)
  type                     String  @default("MIXED") // DENTAL | AESTHETIC | MIXED
  // Horario de funcionamento (JSON por dia da semana)
  working_hours            Json?
  // Logo / branding
  logo_url                 String?
  brand_color              String? // Hex (ex: #F58220)
  // Status
  active                   Boolean @default(true)
  // Para franquias
  is_franchise             Boolean @default(false)
  franchisee_owner_user_id String? // Dono da franquia (se franquia)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_clinics UserClinic[]

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
  @@index([is_franchise])
}

/// Relacao N:N entre User e Clinic com role/permissoes opcionais.
/// Quando um User nao tem registros UserClinic, tem acesso a TODAS as
/// clinicas do tenant (default backward-compatible).
model UserClinic {
  id         String   @id @default(uuid())
  user_id    String
  clinic_id  String
  role       String? // OPERADOR | ADVOGADO | GESTOR | ADMIN | DENTISTA — sobrepoe roles globais nesta unidade
  is_default Boolean  @default(false) // Unidade default ao logar
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinic_id], references: [id], onDelete: Cascade)

  @@unique([user_id, clinic_id])
  @@index([user_id])
  @@index([clinic_id])
}

// ============================================================================
// FASE 16 — SMILE / FACE DESIGN STUDIO (IA de imagem antes/depois)
// ============================================================================
//
// Profissional faz upload de foto do paciente. IA gera simulacao
// antes/depois (sorriso ou harmonizacao facial). Usado como ferramenta
// de venda — aumenta conversao mostrando resultado esperado.
//
// Provider e abstraido: pode ser Replicate, fal.ai, Stability, OpenAI
// gpt-image-1, modelo proprio. Configurado via SettingsService.
// Default: 'mock' (devolve a foto original — placeholder).
//
// CONFORMIDADE CFO Resolucao 118/2012:
//   Toda simulacao deve ser CLARAMENTE rotulada como simulacao,
//   nao garantia. Front-end exibe disclaimer. patient_consent
//   e obrigatorio antes de gerar.

model SmileSimulation {
  id                 String @id @default(uuid())
  tenant_id          String
  patient_id         String
  created_by_user_id String

  simulation_type String // SMILE | FACE_HARMONY | LIPS | RHINOMODULATION | OTHER

  before_s3_key String
  before_url    String?
  after_s3_key  String?
  after_url     String?

  provider          String  @default("mock") // mock | replicate | fal | stability | openai_image | custom
  prompt            String?
  provider_metadata Json?

  status        String  @default("PROCESSING") // PROCESSING | DONE | FAILED
  error_message String?

  patient_consent    Boolean   @default(false)
  patient_consent_at DateTime?

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient    Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  created_by User    @relation("SmileSimulationCreator", fields: [created_by_user_id], references: [id])

  @@index([tenant_id, patient_id])
  @@index([patient_id, created_at])
  @@index([status])
}

// ============================================================================
// FASE 17 — INTEGRACAO RADIOLOGIA (Image2Doc / Proradis / DICOM)
// ============================================================================
//
// Modelo de exames radiograficos recebidos automaticamente de centros
// radiologicos parceiros. O parceiro chama nosso webhook publico
// /webhooks/radiography com:
//   - cpf ou identificador externo do paciente
//   - tipo do exame (PANORAMIC, PERIAPICAL, BITEWING, CT, CBCT)
//   - URL para download da imagem (ou base64 inline)
//   - laudo opcional
// Validacao por X-Radiography-Provider-Key (chave configurada por provider).
//
// Provider tracking:
//   - source = nome do provider (image2doc, proradis, manual, etc.)
//   - source_external_id = ID do exame no sistema do provider (idempotencia)
//
// Integracao DICOM e overlay para o futuro — esta fase trabalha com
// imagens JPG/PNG renderizadas pelo provider, nao DICOM raw.

/// Provider de radiologia configurado (Image2Doc, Proradis etc).
/// Cada provider tem sua chave secreta (api_key_hash) usada no header
/// X-Radiography-Provider-Key para autenticar o webhook.
model RadiographyProvider {
  id               String    @id @default(uuid())
  tenant_id        String
  name             String // 'Image2Doc' | 'Proradis' | etc
  source_slug      String // 'image2doc' | 'proradis' (lowercase, para webhook)
  api_key_hash     String // bcrypt/argon2 da chave secreta
  active           Boolean   @default(true)
  webhook_count    Int       @default(0)
  last_received_at DateTime?
  notes            String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  tenant Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  exams  RadiographyExam[]

  @@unique([tenant_id, source_slug])
  @@index([tenant_id, active])
}

model RadiographyExam {
  id         String  @id @default(uuid())
  tenant_id  String
  patient_id String? // null se nao conseguimos casar com paciente (fica em backlog)

  // Identificacao do parceiro
  provider_id        String?
  source             String // image2doc | proradis | manual | other
  source_external_id String? // ID no sistema do parceiro (idempotencia)

  // Tipo do exame
  exam_type String // PANORAMIC | PERIAPICAL | BITEWING | OCCLUSAL | LATERAL | PA | CT | CBCT | OTHER
  tooth_fdi String? // Dente especifico (para periapical/bitewing)

  // Imagem
  image_s3_key     String
  thumbnail_s3_key String?
  mime_type        String  @default("image/jpeg")

  // Laudo
  report_text String? // Texto livre do radiologista
  report_html String? // HTML rico se vier

  // Datas
  performed_at DateTime? // Data em que o exame foi feito
  received_at  DateTime  @default(now())

  // Status / triagem
  status            String    @default("RECEIVED") // RECEIVED | LINKED | DISCARDED
  linked_at         DateTime? // Quando foi associado a um paciente
  linked_by_user_id String?

  // Match heuristico (CPF, nome, telefone do parceiro para casar com Patient)
  external_patient_cpf  String?
  external_patient_name String?

  // Observacoes da clinica
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient   Patient?             @relation(fields: [patient_id], references: [id], onDelete: SetNull)
  provider  RadiographyProvider? @relation(fields: [provider_id], references: [id], onDelete: SetNull)
  linked_by User?                @relation("RadiographyLinker", fields: [linked_by_user_id], references: [id], onDelete: SetNull)

  @@unique([source, source_external_id])
  @@index([tenant_id, patient_id])
  @@index([patient_id, performed_at])
  @@index([status, received_at])
  @@index([external_patient_cpf])
}

// ═══════════════════════════════════════════════════════════════════════
// FASE 19 — Lista de Espera
// ═══════════════════════════════════════════════════════════════════════
// Quando um lead pede pra agendar mas a agenda do dentista preferido tá
// cheia (ou ele quer um dia/horário específico que não tem vaga), opera-
// dor (ou IA) cria uma WaitlistEntry. Quando algum CalendarEvent ATIVO
// for cancelado/adiado, o worker checa se há entradas na waitlist com
// preferências compatíveis (mesmo dentista + mesma janela de tempo) e
// notifica via WhatsApp os primeiros da fila (FIFO).
//
// Operador pode gerenciar manualmente em /atendimento/waitlist (listar,
// criar, editar, marcar como notificado, agendar, descartar).
// ═══════════════════════════════════════════════════════════════════════
model WaitlistEntry {
  id        String  @id @default(uuid())
  tenant_id String?
  lead_id   String
  lead      Lead    @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  // Preferência de dentista — null = qualquer dentista (Orçamentista)
  dentist_id String?
  dentist    User?   @relation("WaitlistDentist", fields: [dentist_id], references: [id], onDelete: SetNull)

  // Preferência de janela de tempo (opcional)
  // Lead pode dizer "qualquer terça à tarde" → preferred_weekday=2, preferred_period='TARDE'
  // Ou "manhã do dia 15" → preferred_date='2026-05-15', preferred_period='MANHA'
  // Ou "qualquer hora a partir de 01/05" → earliest_date='2026-05-01'
  preferred_date    DateTime? // Data específica (se houver)
  preferred_weekday Int? // 0=dom..6=sab (se quer dia da semana)
  preferred_period  String? // 'MANHA' | 'TARDE' | 'NOITE' | 'QUALQUER'
  earliest_date     DateTime? // Data mínima ('a partir de X')

  // Status do entry
  // AGUARDANDO → AGENDADO (lead aceitou slot oferecido) | NOTIFICADO (avisado mas não respondeu) | DESISTIU | EXPIROU (passou earliest_date sem vaga)
  status       String    @default("AGUARDANDO")
  notes        String? // Notas internas pro time
  notified_at  DateTime? // Última vez que foi notificado
  notify_count Int       @default(0) // Quantas vezes foi notificado (limita re-spam)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  resolved_at DateTime? // Timestamp de quando virou AGENDADO/DESISTIU/EXPIROU

  @@index([tenant_id, status, created_at]) // Listagem filtrada por status (FIFO)
  @@index([lead_id, status]) // "tem entrada ativa pra esse lead?"
  @@index([dentist_id, status, preferred_date]) // Match quando vagar slot do dentista
}
