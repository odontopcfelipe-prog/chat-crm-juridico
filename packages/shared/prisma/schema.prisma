// ===============================================
// Memory System — Lead + Organization memories
// ===============================================

/// Memória persistente sobre leads e sobre o escritório. Cada Memory é uma
/// unidade atômica de conhecimento (1 frase / fato). A coluna `embedding`
/// (pgvector) é adicionada via migration SQL — Prisma não suporta vector
/// nativamente. Use $queryRaw/$executeRaw para operações envolvendo embedding.
model Memory {
  id        String @id @default(uuid())
  tenant_id String

  /// "lead" | "organization"
  scope    String
  /// ID do lead (scope=lead) ou ID do tenant (scope=organization)
  scope_id String

  /// "semantic" | "episodic" | "procedural"
  type        String  @default("semantic")
  /// Subcategoria (scope=organization): office_info | team | fees | procedures | court_info | legal_knowledge | contacts | rules
  subcategory String?

  content String @db.Text

  /// Embedding OpenAI text-embedding-3-small (1536 dim). Tipo pgvector —
  /// Prisma nao suporta nativamente, entao usamos Unsupported. Isso impede
  /// que `prisma db push` REMOVA a coluna por nao reconhece-la no schema.
  /// Leitura/escrita sempre via $queryRawUnsafe/$executeRawUnsafe.
  /// IMPORTANTE: a extensao pgvector deve estar habilitada no Postgres antes
  /// do primeiro `db push` em ambientes novos — ver manual-sql/2026-04-18-memory-system.sql.
  embedding Unsupported("vector(1536)")?

  // Proveniência
  /// "batch" | "manual" | "system" | "retroactive"
  source_type String
  /// ID da conversa que originou (quando source_type=batch)
  source_id   String?
  confidence  Float   @default(1.0)

  // Ciclo de vida
  /// "active" | "superseded" | "archived"
  status        String    @default("active")
  /// Razão da substituição ou ID da memória substituta
  superseded_by String?
  access_count  Int       @default(0)
  last_accessed DateTime?
  expires_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, scope, scope_id])
  @@index([status])
  @@index([tenant_id, subcategory])
}

/// Perfil consolidado do lead — summary em texto corrido + facts JSON.
/// Regenerado pelo cron noturno após extração de memórias. É o "cartão" que
/// a IA lê antes de responder para já conhecer o cliente sem repetir perguntas.
model LeadProfile {
  id        String @id @default(uuid())
  tenant_id String
  lead_id   String @unique
  lead      Lead   @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  /// Texto corrido (~300 palavras) — injetado no system prompt
  summary String @db.Text
  /// JSON estruturado: name, cpf, cases[], preferences, pending, sentiment, risk_flags…
  facts   Json   @default("{}")

  generated_at  DateTime @default(now())
  message_count Int      @default(0)
  version       Int      @default(1)

  @@index([tenant_id])
}

/// Perfil consolidado do ESCRITORIO — resumo em prosa (4 secoes) que substitui
/// a injecao crua das memorias organizacionais no prompt. Mesmo padrao do
/// LeadProfile mas para tenant. 1 registro por tenant.
///
/// Regenerado:
///   - Diariamente as 02h (OrgProfileConsolidationProcessor)
///   - Sob demanda apos create/update/delete de memoria organizacional (debounce)
///   - Via botao manual na tela /atendimento/settings/knowledge
///
/// Na injecao, substitui `{{office_memories}}` no prompt — reduz ruido,
/// resolve conflitos e descarta memorias de baixa confianca.
model OrganizationProfile {
  id        String @id @default(uuid())
  tenant_id String @unique
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  /// Texto estruturado em 4 secoes (About, Team, Procedures, Rules) — ~500 palavras
  summary String @db.Text
  /// JSON estruturado: office_info, team[], fees, procedures[], rules[], etc.
  facts   Json   @default("{}")

  /// Quantas memorias ativas foram usadas como fonte na ultima geracao
  source_memory_count Int @default(0)

  /// Timestamp da ultima edicao manual do admin. Quando nao-null, o cron
  /// automatico das 02h PULA este tenant (nao sobrescreve a edicao). Limpo
  /// quando o admin clica "Regenerar" explicitamente via UI/API.
  manually_edited_at DateTime?

  /// Marca ate quando as memorias ja foram incorporadas ao summary
  /// (modo incremental). Na proxima regen incremental, so processa memorias
  /// criadas/deletadas APOS este timestamp — economiza LLM tokens e preserva
  /// o texto existente. Resetado pelo botao "Refazer do zero" (from-scratch).
  last_incorporated_at DateTime?

  generated_at DateTime @default(now())
  version      Int      @default(1)
}

// ============================================================================
// ODONTOLOGIA — Fase 2 — Entidades clinicas core
// ============================================================================
// Models clinicos do Instituto Odonto Passos. Os modelos juridicos foram
// removidos nas Fases 0.1 e 0.2 da refatoracao odontologica.
// ============================================================================

/// Paciente — cliente ativo da clinica. Criado quando um Lead agenda a primeira
/// consulta. Mantem link opcional ao Lead de origem para preservar o historico
/// de conversas WhatsApp.
model Patient {
  id        String  @id @default(uuid())
  tenant_id String
  lead_id   String? @unique

  // Identificacao
  name       String
  cpf        String?
  rg         String?
  birth_date DateTime?
  gender     String? // "M" | "F" | "OTHER"
  phone      String?
  email      String?

  // Endereco
  address            String?
  address_number     String?
  address_complement String?
  neighborhood       String?
  city               String?
  state              String?
  zip_code           String?

  // Clinico basico (info nao-sensivel; anamnese tem os dados profundos)
  blood_type              String?
  emergency_contact_name  String?
  emergency_contact_phone String?

  // Relacionamento clinico
  primary_dentist_id String?
  referred_by        String? // nome de quem indicou

  // Status do paciente
  status         String    @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "ARCHIVED"
  first_visit_at DateTime?
  last_visit_at  DateTime?

  // Notas administrativas (nao clinicas — nao e prontuario)
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant                Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lead                  Lead?                 @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  primary_dentist       User?                 @relation("PrimaryDentist", fields: [primary_dentist_id], references: [id], onDelete: SetNull)
  allergies             PatientAllergy[]
  medications           PatientMedication[]
  anamneses             Anamnesis[]
  medical_record        MedicalRecord?
  odontogram            Odontogram?
  clinical_images       ClinicalImage[]
  consents              ConsentRecord[]
  quotes                Quote[]
  treatment_plans       TreatmentPlan[]
  appointments          CalendarEvent[]       @relation("PatientAppointments")
  // Estetica facial (Fase 6)
  esthetic_applications EstheticApplication[]
  adverse_reactions     AdverseReaction[]
  // Agenda evoluida (Fase 7)
  return_alerts         ReturnAlert[]
  // Comissoes (Fase 8)
  commissions           Commission[]
  // Regua de cobranca (Fase 11)
  installments          Installment[]
  // Portal do paciente (Fase 13)
  portal_tokens         PortalToken[]
  // Smile/Face Design (Fase 16)
  smile_simulations     SmileSimulation[]
  // Radiologia (Fase 17)
  radiography_exams     RadiographyExam[]

  @@unique([tenant_id, cpf])
  @@index([tenant_id, name])
  @@index([tenant_id, phone])
  @@index([primary_dentist_id])
}

model PatientAllergy {
  id         String   @id @default(uuid())
  patient_id String
  allergen   String // ex: "Penicilina", "Latex", "Anestesico local"
  severity   String? // "MILD" | "MODERATE" | "SEVERE"
  notes      String?
  created_at DateTime @default(now())

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
}

model PatientMedication {
  id         String    @id @default(uuid())
  patient_id String
  medication String
  dosage     String? // "500mg"
  frequency  String? // "1x ao dia", "de 8 em 8h"
  reason     String?
  started_at DateTime?
  ended_at   DateTime?
  created_at DateTime  @default(now())

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
}

// ============================================================================
// CATALOGO CLINICO — Specialty + Procedure
// ============================================================================

model Specialty {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String // "Clinica Geral", "Ortodontia" etc.
  description String?
  icon        String? // nome de icone lucide (opcional — UI)
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  procedures Procedure[]
  dentists   User[]      @relation("UserSpecialties")

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
}

model Procedure {
  id           String  @id @default(uuid())
  tenant_id    String
  specialty_id String?

  name          String
  code_tuss     String? // Codigo TUSS (opcional)
  internal_code String? // Codigo interno da clinica

  description         String?
  duration_minutes    Int     @default(30)
  base_price          Decimal @default(0) @db.Decimal(10, 2)
  requires_x_ray      Boolean @default(false)
  requires_anesthesia Boolean @default(false)

  // Fase 6 — Estetica facial
  /// Categoria detalhada (alem de Specialty):
  /// Odonto:    "PROFILAXIA" | "DENTISTICA" | "ENDODONTIA" | "PERIODONTIA"
  ///            "ORTODONTIA" | "IMPLANTE" | "PROTESE" | "CIRURGIA" | "ESTETICA_DENTAL"
  /// Estetica:  "HOF" | "TOXINA_BOTULINICA" | "PREENCHIMENTO_AH"
  ///            "BIOESTIMULADOR" | "FIOS_PDO" | "FIOS_PLLA" | "PEELING_QUIMICO"
  ///            "MICROAGULHAMENTO" | "SKINBOOSTER" | "LASER" | "RADIOFREQUENCIA"
  ///            "ULTRASSOM_MICROFOCADO" | "LIPO_ENZIMATICA" | "LIMPEZA_PELE"
  category String?

  /// Procedimento estetico facial (true) — habilita FacialMap na UI
  is_facial_application       Boolean @default(false)
  /// Validade media do efeito (ex: AH=12, Botox=4-6, Sculptra=24)
  default_revisit_months      Int?
  /// Cuidados pos-procedimento padrao (texto informativo ao paciente)
  post_procedure_instructions String?

  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant                Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  specialty             Specialty?            @relation(fields: [specialty_id], references: [id], onDelete: SetNull)
  quote_items           QuoteItem[]
  treatment_plan_items  TreatmentPlanItem[]
  // Fase 6
  consumables           ProcedureConsumable[]
  esthetic_applications EstheticApplication[]
  adverse_reactions     AdverseReaction[]     @relation("ProcedureAdverseReactions")
  // Fase 8 — comissoes
  commissions           Commission[]          @relation("CommissionProcedure")

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
  @@index([tenant_id, category])
  @@index([specialty_id])
}

// ============================================================================
// ANAMNESE — Template versionado + respostas do paciente
// ============================================================================

/// Template de perguntas (1 por tenant, versionado). Admin pode editar;
/// anamneses ja preenchidas preservam snapshot do schema vigente na hora.
model AnamnesisTemplate {
  id        String @id @default(uuid())
  tenant_id String
  version   Int    @default(1)

  /// Estrutura das perguntas:
  /// { "sections": [ { "id": "...", "title": "...", "questions": [...] } ] }
  schema Json

  active     Boolean  @default(true)
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  anamneses Anamnesis[]

  @@unique([tenant_id, version])
  @@index([tenant_id, active])
}

model Anamnesis {
  id          String @id @default(uuid())
  patient_id  String
  template_id String

  /// Respostas: { "question_id": "answer" }
  answers         Json @default("{}")
  /// Snapshot do schema usado (preserva historico mesmo se template mudar)
  template_schema Json

  filled_by_user_id String?
  filled_at         DateTime @default(now())
  updated_at        DateTime @updatedAt

  patient  Patient           @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  template AnamnesisTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)

  @@index([patient_id, filled_at])
}

// ============================================================================
// PRONTUARIO — MedicalRecord + ClinicalNote (SOAP)
// ============================================================================

/// Raiz do prontuario. 1 por paciente. Armazena meta-info; as notas reais ficam
/// em ClinicalNote.
model MedicalRecord {
  id              String  @id @default(uuid())
  patient_id      String  @unique
  chief_complaint String? // queixa principal
  history         String? // historia da doenca atual

  opened_at  DateTime  @default(now())
  closed_at  DateTime? // quando paciente recebe alta
  updated_at DateTime  @updatedAt

  patient Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  notes   ClinicalNote[]

  @@index([patient_id])
}

/// Nota clinica (formato SOAP). Imutavel apos is_finalized=true (so addendum).
model ClinicalNote {
  id                String  @id @default(uuid())
  medical_record_id String
  appointment_id    String?
  author_user_id    String

  subjective String? // "S" — relato do paciente
  objective  String? // "O" — exame clinico
  assessment String? // "A" — diagnostico
  plan       String? // "P" — plano imediato

  /// IDs de TreatmentPlanItem executados nesta sessao
  executed_items String[] @default([])

  is_finalized Boolean   @default(false)
  finalized_at DateTime?

  /// Correcao apos finalizacao — so adiciona, nao sobrescreve
  addendum    String?
  addendum_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  medical_record        MedicalRecord         @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)
  author                User                  @relation("ClinicalNoteAuthor", fields: [author_user_id], references: [id], onDelete: Restrict)
  appointment           CalendarEvent?        @relation("AppointmentNotes", fields: [appointment_id], references: [id], onDelete: SetNull)
  clinical_images       ClinicalImage[]
  // Estetica facial (Fase 6) — aplicacoes registradas nesta nota
  esthetic_applications EstheticApplication[] @relation("ClinicalNoteEstheticApplications")

  @@index([medical_record_id, created_at])
  @@index([author_user_id])
  @@index([appointment_id])
}

// ============================================================================
// ODONTOGRAMA — Odontogram + ToothRecord (notacao FDI)
// ============================================================================

/// Estado odontologico atual. 1 por paciente. Dentes higidos nao geram
/// ToothRecord — so os que tem anotacao (carie, restauracao, ausencia, etc).
model Odontogram {
  id         String @id @default(uuid())
  patient_id String @unique

  /// Meta JSON: { "dentition_stage": "permanent"|"mixed"|"deciduous", "notes": "..." }
  meta Json @default("{}")

  last_updated_by_user_id String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  patient Patient       @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  teeth   ToothRecord[]
}

/// Registro de dente. Notacao FDI: 11-48 (permanente), 51-85 (deciduo).
model ToothRecord {
  id            String  @id @default(uuid())
  odontogram_id String
  tooth_fdi     String // "11", "36", "51"
  face          String? // "M","D","O","V","L","INCISAL" ou null = dente inteiro

  state    String // "CARIE","RESTAURADO","AUSENTE","PROTESE","IMPLANTE","ENDODONTIA","EXTRACAO_INDICADA","COROA","FRATURA","OUTROS"
  material String? // "COMPOSITE","AMALGAMA","PORCELANA","METAL"

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  odontogram Odontogram @relation(fields: [odontogram_id], references: [id], onDelete: Cascade)

  @@index([odontogram_id, tooth_fdi])
}

// ============================================================================
// IMAGENS CLINICAS — Raio-X, foto intraoral, foto facial
// ============================================================================

model ClinicalImage {
  id               String  @id @default(uuid())
  patient_id       String
  media_id         String? // link com Media (binario)
  clinical_note_id String?

  kind        String // "XRAY_PANORAMIC","XRAY_BITEWING","XRAY_PERIAPICAL","PHOTO_INTRAORAL_FRONT","PHOTO_INTRAORAL_OCCLUSAL","PHOTO_FACE","PHOTO_OTHER"
  tooth_fdi   String?
  description String?
  date_taken  DateTime

  uploaded_by_user_id String?
  created_at          DateTime @default(now())

  patient       Patient       @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  clinical_note ClinicalNote? @relation(fields: [clinical_note_id], references: [id], onDelete: SetNull)

  @@index([patient_id, date_taken])
  @@index([clinical_note_id])
}

// ============================================================================
// CONSENTIMENTO — LGPD + TCLE + Imagem
// ============================================================================

model ConsentRecord {
  id                String  @id @default(uuid())
  patient_id        String
  treatment_plan_id String?

  type         String // "LGPD_DATA_PROCESSING" | "TREATMENT_CONSENT" | "IMAGE_USE" | "ANESTHESIA"
  version_text String // versao do termo aceito (texto/identificador)

  consented_at         DateTime @default(now())
  consented_by_user_id String?
  ip_address           String?
  user_agent           String?

  // ClickSign (quando aplicavel — TCLE clinico de plano)
  clicksign_document_key String?
  clicksign_signed_at    DateTime?
  signed_document_s3_key String?

  // Revogacao (LGPD direito ao esquecimento)
  revoked_at     DateTime?
  revoked_reason String?

  created_at DateTime @default(now())

  patient        Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  treatment_plan TreatmentPlan? @relation(fields: [treatment_plan_id], references: [id], onDelete: SetNull)

  @@index([patient_id, type])
  @@index([treatment_plan_id])
}

// ============================================================================
// ORCAMENTO + PLANO DE TRATAMENTO
// ============================================================================

model Quote {
  id                 String @id @default(uuid())
  patient_id         String
  created_by_user_id String

  status      String    @default("DRAFT") // "DRAFT"|"SENT"|"ACCEPTED"|"REJECTED"|"EXPIRED"
  valid_until DateTime?

  subtotal         Decimal @default(0) @db.Decimal(10, 2)
  discount_percent Decimal @default(0) @db.Decimal(5, 2)
  discount_value   Decimal @default(0) @db.Decimal(10, 2)
  total_value      Decimal @default(0) @db.Decimal(10, 2)

  payment_terms String? // "A vista", "10x sem juros"
  notes         String?

  sent_at          DateTime?
  accepted_at      DateTime?
  rejected_at      DateTime?
  rejection_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient        Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  created_by     User           @relation("QuoteCreator", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  items          QuoteItem[]
  treatment_plan TreatmentPlan?
  // Fase 8 — comissoes geradas pelos pagamentos deste orcamento
  commissions    Commission[]   @relation("CommissionQuote")
  // Fase 11 — parcelas geradas pela aprovacao deste orcamento
  installments   Installment[]  @relation("QuoteInstallments")

  @@index([patient_id, status])
  @@index([status, valid_until])
}

model QuoteItem {
  id           String  @id @default(uuid())
  quote_id     String
  procedure_id String
  tooth_fdi    String?

  quantity    Int     @default(1)
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)
  notes       String?
  order_index Int     @default(0)

  quote     Quote     @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedure_id], references: [id], onDelete: Restrict)

  @@index([quote_id])
}

model TreatmentPlan {
  id         String  @id @default(uuid())
  patient_id String
  quote_id   String? @unique

  status String @default("PENDING_SIGNATURE") // "PENDING_SIGNATURE"|"ACTIVE"|"PAUSED"|"COMPLETED"|"CANCELLED"

  start_date         DateTime?
  end_date           DateTime?
  estimated_sessions Int?
  total_value        Decimal   @default(0) @db.Decimal(10, 2)

  /// ClickSign — plano so fica ACTIVE apos assinatura
  contract_signature_id String? @unique

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient            Patient             @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  quote              Quote?              @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  contract_signature ContractSignature?  @relation(fields: [contract_signature_id], references: [id], onDelete: SetNull)
  items              TreatmentPlanItem[]
  consents           ConsentRecord[]

  @@index([patient_id, status])
  @@index([status])
}

model TreatmentPlanItem {
  id                String  @id @default(uuid())
  treatment_plan_id String
  procedure_id      String
  tooth_fdi         String?

  quantity    Int     @default(1)
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)

  status String @default("PENDING") // "PENDING"|"SCHEDULED"|"IN_PROGRESS"|"DONE"|"CANCELLED"

  scheduled_at             DateTime?
  scheduled_appointment_id String?

  executed_at         DateTime?
  executed_by_user_id String?

  notes       String?
  order_index Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  treatment_plan        TreatmentPlan         @relation(fields: [treatment_plan_id], references: [id], onDelete: Cascade)
  procedure             Procedure             @relation(fields: [procedure_id], references: [id], onDelete: Restrict)
  scheduled_appointment CalendarEvent?        @relation("TreatmentPlanItemAppointment", fields: [scheduled_appointment_id], references: [id], onDelete: SetNull)
  executed_by           User?                 @relation("TreatmentPlanItemExecutor", fields: [executed_by_user_id], references: [id], onDelete: SetNull)
  esthetic_applications EstheticApplication[]
  // Fase 8 — comissao gerada por execucao deste item
  commissions           Commission[]          @relation("CommissionTreatmentItem")

  @@index([treatment_plan_id, status])
  @@index([scheduled_appointment_id])
  @@index([executed_by_user_id])
}

// ============================================================================
// FASE 6 — ESTETICA FACIAL AVANCADA + ESTOQUE COM RASTREABILIDADE ANVISA
// ============================================================================
//
// Cobre toxina botulinica, acido hialuronico, bioestimuladores, fios de
// PDO/PLLA, peelings quimicos, microagulhamento, skinboosters, laser,
// radiofrequencia, ultrassom microfocado, lipo enzimatica.
//
// Conformidade:
// - ANVISA: rastreabilidade obrigatoria de lote/validade para injetaveis
//   (RDC 751/2022 e correlatas)
// - CFO Resolucao 230/2020: HOF e especialidade odontologica reconhecida
// - Reacao adversa pode ser notificada via NOTIVISA
//
// Mapa facial: 30 pontos padronizados (frontal, glabela, pe-de-galinha,
// nasolabial, etc.) — armazenados como string para flexibilidade.

// ============================================================================
// ESTOQUE — Supplier + Product + StockMovement + ProcedureConsumable
// ============================================================================

/// Fornecedor (laboratorio de protese, distribuidora de insumos, etc.).
model Supplier {
  id           String   @id @default(uuid())
  tenant_id    String
  name         String
  cnpj         String?
  category     String? // "LABORATORIO" | "INSUMOS" | "EQUIPAMENTOS" | "SERVICOS" | "OUTRO"
  contact_name String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products  Product[]
  movements StockMovement[]

  @@index([tenant_id, active])
  @@index([tenant_id, name])
}

/// Produto de estoque (insumo odontologico ou injetavel estetico).
///
/// Para injetaveis (toxina botulinica, acido hialuronico, bioestimuladores,
/// fios), `requires_lot_tracking` deve ser true — exigencia regulatoria
/// ANVISA para rastreabilidade caso ocorra reacao adversa ou recall.
/// Cada EstheticApplication referencia o lote utilizado.
model Product {
  id          String  @id @default(uuid())
  tenant_id   String
  supplier_id String?

  name    String
  brand   String? // Marca comercial (Allergan, Juvederm, Sculptra…)
  sku     String?
  barcode String?

  /// Categorias suportadas:
  /// Odonto:    "ANESTESICO" | "RESINA" | "BRACKETS" | "EQUIPAMENTO" | "DESCARTAVEL"
  /// Estetica:  "TOXINA_BOTULINICA" | "ACIDO_HIALURONICO" | "BIOESTIMULADOR"
  ///            "FIO_PDO" | "FIO_PLLA" | "ENZIMA" | "PEELING_QUIMICO"
  ///            "SKINBOOSTER" | "ANESTESICO_TOPICO" | "COSMETICO"
  category    String?
  unit        String  @default("UN") // "UN" | "ML" | "MG" | "UI" | "CAIXA" | "KIT"
  description String?

  // Regulatorio (ANVISA)
  anvisa_registration   String? // No de registro ANVISA
  is_injectable         Boolean @default(false) // Aplicacao injetavel (regra mais rigida)
  is_controlled         Boolean @default(false) // Substancia controlada
  requires_lot_tracking Boolean @default(false) // Lote obrigatorio por aplicacao

  // Estoque
  current_stock Decimal  @default(0) @db.Decimal(10, 3)
  min_stock     Decimal? @db.Decimal(10, 3) // Alerta de reposicao
  max_stock     Decimal? @db.Decimal(10, 3)

  // Preco
  cost_price Decimal? @db.Decimal(10, 2) // Custo (para margem)
  sale_price Decimal? @db.Decimal(10, 2) // Venda avulsa (se aplicavel)

  has_expiration Boolean @default(false)

  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant                Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier              Supplier?             @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  movements             StockMovement[]
  consumables           ProcedureConsumable[]
  esthetic_applications EstheticApplication[]

  @@unique([tenant_id, sku])
  @@index([tenant_id, name])
  @@index([tenant_id, category])
  @@index([anvisa_registration])
  @@index([active])
}

/// Movimento de estoque: entrada de compra, saida por procedimento,
/// ajuste manual, descarte por vencimento.
model StockMovement {
  id          String  @id @default(uuid())
  tenant_id   String
  product_id  String
  supplier_id String?

  type       String // "ENTRADA" | "SAIDA" | "AJUSTE" | "DESCARTE_VENCIMENTO" | "PERDA"
  quantity   Decimal  @db.Decimal(10, 3) // Sempre positiva — type define direcao
  unit_cost  Decimal? @db.Decimal(10, 2)
  total_cost Decimal? @db.Decimal(10, 2)

  // Lote/validade (obrigatorios quando product.requires_lot_tracking = true)
  batch_number    String?
  expiration_date DateTime?

  // Vinculos
  appointment_id       String? // Saida ligada a um atendimento
  notes                String?
  performed_by_user_id String?
  performed_at         DateTime @default(now())
  created_at           DateTime @default(now())

  tenant       Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  supplier     Supplier?      @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  appointment  CalendarEvent? @relation("AppointmentStockMovements", fields: [appointment_id], references: [id], onDelete: SetNull)
  performed_by User?          @relation("StockMover", fields: [performed_by_user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, product_id])
  @@index([type, performed_at])
  @@index([batch_number])
  @@index([expiration_date])
}

/// Vinculo procedimento <-> insumo. Permite baixa automatica do estoque
/// ao executar um procedimento e calculo do custo real.
model ProcedureConsumable {
  id           String   @id @default(uuid())
  procedure_id String
  product_id   String
  quantity     Decimal  @db.Decimal(10, 3) // Quantidade consumida por execucao
  notes        String?
  created_at   DateTime @default(now())

  procedure Procedure @relation(fields: [procedure_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([procedure_id, product_id])
  @@index([product_id])
}

// ============================================================================
// ESTETICA FACIAL — EstheticApplication (mapa de 30 pontos + lote)
// ============================================================================

/// Aplicacao de procedimento estetico em ponto facial especifico.
/// Cada aplicacao registra produto + lote + volume + ponto + tecnica,
/// gerando rastreabilidade ANVISA e historico para o paciente.
///
/// Pontos faciais padronizados (campo `application_point`):
///   FRONTAL, GLABELA, PE_DE_GALINHA_DIR, PE_DE_GALINHA_ESQ,
///   SUPRACILIAR_DIR, SUPRACILIAR_ESQ, NASAL_DORSO, PONTA_NASAL,
///   BUNNY_LINES, MENTO, MASSETER_DIR, MASSETER_ESQ,
///   NASOLABIAL_DIR, NASOLABIAL_ESQ, MARIONETE_DIR, MARIONETE_ESQ,
///   LABIO_SUPERIOR, LABIO_INFERIOR, COMISSURA_DIR, COMISSURA_ESQ,
///   MALAR_DIR, MALAR_ESQ, MANDIBULA_DIR, MANDIBULA_ESQ,
///   PESCOCO, PLATISMA, COLO, TEMPORAL_DIR, TEMPORAL_ESQ, OUTRO
model EstheticApplication {
  id         String @id @default(uuid())
  tenant_id  String
  patient_id String

  // Vinculos opcionais
  procedure_id           String? // Procedimento do catalogo
  clinical_note_id       String? // Nota SOAP que registrou
  appointment_id         String? // Consulta em que foi executado
  treatment_plan_item_id String? // Item do plano de tratamento

  // Anatomia facial
  application_point String // ver lista acima
  side              String? // "DIREITA" | "ESQUERDA" | "BILATERAL" | "CENTRAL"

  // Produto aplicado (rastreabilidade ANVISA)
  product_id            String?
  product_name_snapshot String? // Snapshot — produto pode ser descontinuado
  brand_snapshot        String? // Marca no momento da aplicacao
  batch_number          String? // LOTE — obrigatorio para injetaveis
  expiration_date       DateTime? // Validade do lote usado

  // Quantidade
  volume       Decimal? @db.Decimal(10, 3) // mL ou UI
  unit         String? // "ML" | "UI" | "MG"
  dilution     String? // Ex: "100UI/2mL"
  needle_gauge String? // Ex: "30G", "27G"

  // Tecnica
  technique String? // "BOLUS" | "RETROINJECAO" | "FANNING" | "CROSSHATCH" | "MAP" | "ROLAMENTO" | "OUTRO"
  depth     String? // "SUPERFICIAL" | "MEDIO" | "PROFUNDO" | "SUPRAPERIOSTAL" | "SUBDERMICO"

  notes String?

  // Validade do efeito (gera lembrete de retorno automatico)
  expected_duration_months Int? // Ex: AH=12-18, Botox=4-6, Sculptra=24
  expected_revisit_at      DateTime? // Calculado: applied_at + duration

  applied_by_user_id String
  applied_at         DateTime @default(now())
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tenant              Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient             Patient            @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  procedure           Procedure?         @relation(fields: [procedure_id], references: [id], onDelete: SetNull)
  clinical_note       ClinicalNote?      @relation("ClinicalNoteEstheticApplications", fields: [clinical_note_id], references: [id], onDelete: SetNull)
  appointment         CalendarEvent?     @relation("AppointmentEstheticApplications", fields: [appointment_id], references: [id], onDelete: SetNull)
  treatment_plan_item TreatmentPlanItem? @relation(fields: [treatment_plan_item_id], references: [id], onDelete: SetNull)
  product             Product?           @relation(fields: [product_id], references: [id], onDelete: SetNull)
  applied_by          User               @relation("EstheticApplicator", fields: [applied_by_user_id], references: [id], onDelete: Restrict)
  adverse_reactions   AdverseReaction[]

  @@index([tenant_id, patient_id])
  @@index([patient_id, applied_at])
  @@index([batch_number]) // Rastreabilidade reversa: dado um lote, quem usou?
  @@index([product_id])
  @@index([expected_revisit_at])
}

// ============================================================================
// REACAO ADVERSA — registro clinico + base para NOTIVISA/ANVISA
// ============================================================================

/// Registro de reacao adversa pos-aplicacao estetica/odontologica.
/// Obrigacao etico-legal do profissional. Permite alimentar base para
/// eventual notificacao via NOTIVISA/ANVISA.
model AdverseReaction {
  id                      String  @id @default(uuid())
  tenant_id               String
  patient_id              String
  esthetic_application_id String?
  procedure_id            String?

  severity      String // "LEVE" | "MODERADA" | "GRAVE" | "AMEACA_VIDA"
  reaction_type String // "EDEMA" | "EQUIMOSE" | "NODULO" | "INFECCAO" | "NECROSE" | "ALERGIA" | "ASSIMETRIA" | "MIGRACAO" | "EMBOLIA" | "OUTRO"

  description      String
  onset_at         DateTime // Inicio dos sintomas
  resolved_at      DateTime?
  resolution_notes String?

  // Conduta
  treatment_given String? // Hialuronidase, antibiotico, corticoide, observacao…
  hospitalized    Boolean @default(false)

  // Notificacao regulatoria
  notivisa_reported    Boolean   @default(false)
  notivisa_reported_at DateTime?
  notivisa_protocol    String?

  reported_by_user_id String
  reported_at         DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  tenant               Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient              Patient              @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  esthetic_application EstheticApplication? @relation(fields: [esthetic_application_id], references: [id], onDelete: SetNull)
  procedure            Procedure?           @relation("ProcedureAdverseReactions", fields: [procedure_id], references: [id], onDelete: SetNull)
  reported_by          User                 @relation("AdverseReactionReporter", fields: [reported_by_user_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, patient_id])
  @@index([severity])
  @@index([esthetic_application_id])
  @@index([reported_at])
}

// ============================================================================
// FASE 7 — AGENDA EVOLUIDA (multi-recurso, marcadores, confirmacao, retorno)
// ============================================================================
//
// Adiciona ao modulo de agenda:
//  - Sala/cadeira como recurso fisico reservavel (Room)
//  - Marcadores (tags) reutilizaveis aplicados a agendamentos
//  - Confirmacao por canal (auditavel)
//  - Alerta de retorno programado (carro-chefe Clinicorp)
//
// CalendarEvent ganha room_id (nullable) — eventos antigos continuam validos.
// Cores semanticas (cinza/branco/rosa/vermelho) sao calculadas no front-end
// a partir dos campos status + start_at/end_at, nao precisam de coluna nova.

// ============================================================================
// Room — sala/cadeira
// ============================================================================

/// Recurso fisico (cadeira odontologica, sala de cirurgia, sala de HOF).
/// Permite agenda multi-recurso (profissional × cadeira) e detectar
/// conflitos de sala alem de conflitos de profissional.
model Room {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String // "Cadeira 1", "Sala de Cirurgia", "Sala HOF"
  description String?
  color       String? // Cor hex para destaque na agenda (#FF6A1A)
  capacity    Int      @default(1) // Quantos pacientes simultaneos a sala suporta
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  appointments CalendarEvent[] @relation("AppointmentRoom")

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
}

// ============================================================================
// AppointmentMarker — tags reutilizaveis para agendamentos
// ============================================================================

/// Marcador (tag) aplicavel a agendamento: "Indicacao", "VIP", "Plano X",
/// "Retorno 6 meses", "Primeira consulta", etc. Geram relatorios filtrados.
model AppointmentMarker {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  color      String? // Hex para badge na UI (#28A745)
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant      Tenant                        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  assignments AppointmentMarkerAssignment[]

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
}

/// Pivot N:N entre CalendarEvent e AppointmentMarker.
model AppointmentMarkerAssignment {
  id             String   @id @default(uuid())
  appointment_id String
  marker_id      String
  created_at     DateTime @default(now())

  appointment CalendarEvent     @relation("AppointmentMarkers", fields: [appointment_id], references: [id], onDelete: Cascade)
  marker      AppointmentMarker @relation(fields: [marker_id], references: [id], onDelete: Cascade)

  @@unique([appointment_id, marker_id])
  @@index([marker_id])
}

// ============================================================================
// AppointmentConfirmation — tentativa de confirmacao auditavel por canal
// ============================================================================

/// Cada disparo de confirmacao (WhatsApp/SMS/email/app/manual) gera um
/// registro proprio com timestamp, mensagem enviada, canal e resposta do
/// paciente. Substitui flag binaria "confirmou/nao confirmou" — permite
/// auditoria completa e contagem de tentativas por canal.
model AppointmentConfirmation {
  id              String    @id @default(uuid())
  appointment_id  String
  channel         String // "WHATSAPP" | "SMS" | "EMAIL" | "APP_PUSH" | "CLOUDIA" | "MANUAL"
  scheduled_for   DateTime? // Quando deveria sair (ex: 24h antes)
  sent_at         DateTime?
  message_text    String?
  // Resposta do paciente
  response_status String    @default("PENDENTE") // "PENDENTE" | "CONFIRMADO" | "REJEITADO" | "REMARCADO" | "SEM_RESPOSTA"
  response_at     DateTime?
  response_text   String?
  // Vinculo opcional ao Message do WhatsApp recebido
  message_id      String?
  delivery_status String? // "SENT" | "DELIVERED" | "READ" | "FAILED"
  created_at      DateTime  @default(now())

  appointment CalendarEvent @relation("AppointmentConfirmations", fields: [appointment_id], references: [id], onDelete: Cascade)

  @@index([appointment_id, channel])
  @@index([response_status])
  @@index([scheduled_for])
}

// ============================================================================
// ReturnAlert — alerta de retorno programado (carro-chefe Clinicorp)
// ============================================================================

/// Ao final de um atendimento, o profissional programa um alerta de retorno
/// ("voltar em 6 meses para revisao", "refinamento alinhador em 90 dias",
/// "retorno HOF em 4 meses"). Quando chega scheduled_for, vira tarefa da
/// recepcao para reagendar — gera receita recorrente com pacientes que
/// "somem depois do primeiro atendimento".
model ReturnAlert {
  id                       String    @id @default(uuid())
  tenant_id                String
  patient_id               String
  professional_user_id     String?
  source_appointment_id    String? // Consulta que originou o alerta
  // Alvo
  scheduled_for            DateTime // Quando entra na lista da recepcao
  reason                   String? // "Retorno limpeza 6m", "Refinamento alinhador", etc.
  notes                    String?
  // Status
  status                   String    @default("PENDENTE") // "PENDENTE" | "CONTATADO" | "AGENDADO" | "REJEITADO" | "EXPIRADO"
  contacted_at             DateTime?
  contacted_by_user_id     String?
  scheduled_appointment_id String? // Se gerou novo agendamento
  // Timestamps
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  tenant                Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient               Patient        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  professional          User?          @relation("ReturnAlertProfessional", fields: [professional_user_id], references: [id], onDelete: SetNull)
  contacted_by          User?          @relation("ReturnAlertContact", fields: [contacted_by_user_id], references: [id], onDelete: SetNull)
  source_appointment    CalendarEvent? @relation("AppointmentSourceAlerts", fields: [source_appointment_id], references: [id], onDelete: SetNull)
  scheduled_appointment CalendarEvent? @relation("AppointmentScheduledByAlert", fields: [scheduled_appointment_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, scheduled_for])
  @@index([patient_id])
  @@index([status, scheduled_for])
  @@index([professional_user_id])
}

// ============================================================================
// FASE 8 — COMISSOES + METAS
// ============================================================================
//
// Comissoes:
//  - CommissionRule define regra (% ou fixo, por profissional/procedimento/
//    categoria) com prioridade implicita por especificidade.
//  - Commission e a comissao gerada por execucao — transita DEVIDA -> DISPONIVEL
//    (quando paciente paga) -> PAGA (quando clinica liquida com profissional).
//  - Trigger configuravel: ON_EXECUTION (libera ja na execucao) ou ON_PAYMENT
//    (so libera quando paciente paga — modelo Clinicorp, alinha incentivo).
//
// Metas:
//  - Goal com tipo (vendas/primeiras consultas/ocupacao/faltas), escopo
//    (clinica ou profissional), direcao (atingir vs nao ultrapassar), periodo.
//  - Cache current_value + projected_value (preenchido por job cron).

// ============================================================================
// CommissionRule — regra de comissao configuravel
// ============================================================================

model CommissionRule {
  id                   String @id @default(uuid())
  tenant_id            String
  professional_user_id String

  // Escopo (todos opcionais — quanto mais especifico, maior prioridade)
  procedure_id       String?
  procedure_category String?

  // Valor (use percentage OU fixed_value, nao ambos)
  percentage  Decimal? @db.Decimal(5, 2) // % sobre valor pago
  fixed_value Decimal? @db.Decimal(10, 2) // R$ fixo por execucao

  // Quando libera comissao (Clinicorp libera no recebimento)
  trigger String @default("ON_PAYMENT") // "ON_EXECUTION" | "ON_PAYMENT"

  // Vigencia
  active    Boolean   @default(true)
  starts_at DateTime?
  ends_at   DateTime?

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  professional User   @relation("CommissionRuleProfessional", fields: [professional_user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, professional_user_id])
  @@index([active])
}

// ============================================================================
// Commission — comissao gerada por execucao
// ============================================================================

model Commission {
  id                   String  @id @default(uuid())
  tenant_id            String
  professional_user_id String
  patient_id           String
  procedure_id         String?

  // Vinculo opcional ao item de plano executado
  treatment_plan_item_id String?
  // Vinculo opcional ao orcamento/pagamento que liberou
  quote_id               String?

  // Valor base e calculado
  base_value  Decimal  @db.Decimal(10, 2)
  percentage  Decimal? @db.Decimal(5, 2)
  fixed_value Decimal? @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)

  // Status / fluxo
  status         String    @default("DEVIDA") // "DEVIDA" | "DISPONIVEL" | "PAGA" | "CANCELADA"
  available_at   DateTime?
  paid_at        DateTime?
  payment_method String? // PIX, TRANSFERENCIA, DINHEIRO

  reference_month String? // "2026-04" para agrupar mensalmente
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant              Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  professional        User               @relation("CommissionRecipient", fields: [professional_user_id], references: [id])
  patient             Patient            @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  procedure           Procedure?         @relation("CommissionProcedure", fields: [procedure_id], references: [id], onDelete: SetNull)
  treatment_plan_item TreatmentPlanItem? @relation("CommissionTreatmentItem", fields: [treatment_plan_item_id], references: [id], onDelete: SetNull)
  quote               Quote?             @relation("CommissionQuote", fields: [quote_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, professional_user_id, reference_month])
  @@index([status])
  @@index([available_at])
}

// ============================================================================
// Goal — meta com projecao
// ============================================================================

model Goal {
  id        String @id @default(uuid())
  tenant_id String

  // Tipo de meta
  metric String // "SALES_VALUE" | "FIRST_CONSULTATIONS" | "MISSES_PCT" | "OCCUPATION_PCT" | "NEW_PATIENTS" | "CONVERSIONS" | "CUSTOM"

  // Escopo
  scope                String  @default("CLINIC") // "CLINIC" | "PROFESSIONAL"
  professional_user_id String?

  // Direcao (atingir vs nao ultrapassar)
  direction    String  @default("ACHIEVE") // "ACHIEVE" (vendas) | "LIMIT" (faltas)
  target_value Decimal @db.Decimal(12, 2)

  // Periodo
  period_type  String   @default("MONTHLY") // "DAILY" | "WEEKLY" | "MONTHLY" | "QUARTERLY" | "YEARLY" | "CUSTOM"
  period_start DateTime
  period_end   DateTime

  // Cache (preenchido por job cron)
  current_value      Decimal?  @default(0) @db.Decimal(12, 2)
  projected_value    Decimal?  @db.Decimal(12, 2) // "no ritmo atual"
  last_calculated_at DateTime?

  // Status
  active     Boolean  @default(true)
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  professional User?  @relation("GoalProfessional", fields: [professional_user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, period_start])
  @@index([metric, active])
  @@index([professional_user_id])
}

// ============================================================================
// FASE 11 — REGUA DE COBRANCA (Installment + CollectionAttempt)
// ============================================================================

model Installment {
  id         String  @id @default(uuid())
  tenant_id  String
  patient_id String
  // Origem (qual orcamento gerou)
  quote_id   String?

  // Posicao
  sequence    Int @default(1)
  total_count Int @default(1)

  // Valores
  amount         Decimal @db.Decimal(10, 2)
  amount_paid    Decimal @default(0) @db.Decimal(10, 2)
  discount_value Decimal @default(0) @db.Decimal(10, 2)
  fee_value      Decimal @default(0) @db.Decimal(10, 2) // juros/multa por atraso

  // Datas
  due_date DateTime
  paid_at  DateTime?

  // Pagamento
  payment_method String? // PIX | BOLETO | CARTAO | DINHEIRO | TRANSFERENCIA | MAQUININHA
  status         String  @default("ABERTA") // ABERTA | PAGA | PARCIAL | ATRASADA | CANCELADA | RENEGOCIADA

  // Vinculos opcionais
  gateway_charge_id  String? @unique
  nota_fiscal_id     String? @unique
  renegotiated_to_id String?

  // Estado da regua de cobranca
  collection_stage   String? // PRE_DUE_3D | DUE_DAY | D_PLUS_1 | D_PLUS_7 | D_PLUS_15 | D_PLUS_30
  last_collection_at DateTime?

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant              Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient             Patient               @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  quote               Quote?                @relation("QuoteInstallments", fields: [quote_id], references: [id], onDelete: SetNull)
  renegotiated_to     Installment?          @relation("InstallmentRenegotiation", fields: [renegotiated_to_id], references: [id], onDelete: SetNull)
  renegotiated_from   Installment[]         @relation("InstallmentRenegotiation")
  collection_attempts CollectionAttempt[]
  // Fase 18 — cobranca via gateway (Asaas/Iugu/etc)
  payment_charge      PaymentGatewayCharge?

  @@index([tenant_id, due_date])
  @@index([patient_id, status])
  @@index([status, due_date])
  @@index([quote_id, sequence])
  @@index([gateway_charge_id])
}

model CollectionAttempt {
  id             String @id @default(uuid())
  installment_id String

  stage   String // PRE_DUE_3D | DUE_DAY | D_PLUS_1 | D_PLUS_7 | D_PLUS_15 | D_PLUS_30
  channel String // WHATSAPP | SMS | EMAIL | LIGACAO | APP_PUSH

  message_text    String?
  sent_at         DateTime @default(now())
  delivery_status String? // SENT | DELIVERED | READ | FAILED | BOUNCED

  response_at   DateTime?
  response_text String?
  message_id    String?

  installment Installment @relation(fields: [installment_id], references: [id], onDelete: Cascade)

  @@index([installment_id, stage])
  @@index([sent_at])
  @@index([delivery_status])
}

// ============================================================================
// FASE 13 — PORTAL DO PACIENTE (PWA)
// ============================================================================
//
// Login magico: recepcao gera token unico via API, dispara WhatsApp com
// link contendo o token. Paciente clica no link, valida o token, ganha
// JWT proprio e acessa o portal.
//
// PortalToken: uso unico para troca por JWT. Expira em 7 dias.

model PortalToken {
  id          String    @id @default(uuid())
  tenant_id   String
  patient_id  String
  // Token aleatorio (sera incluido no link enviado por WhatsApp)
  token       String    @unique
  // Quando ja foi usado (1x apenas — gera JWT e marca consumido)
  consumed_at DateTime?
  // Validade (default created_at + 7 dias)
  expires_at  DateTime
  // Metadados
  ip_address  String?
  user_agent  String?
  channel     String    @default("WHATSAPP") // WHATSAPP | EMAIL | SMS | MANUAL
  created_at  DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, patient_id])
  @@index([token])
  @@index([expires_at])
}

// ============================================================================
// FASE 15 — MULTI-UNIDADE / FRANQUIAS (Enterprise)
// ============================================================================
//
// Clinic representa uma sub-unidade dentro do tenant (rede ou franquia).
// Para franquias com tenant proprio, Clinic e overlay opcional.
//
// UserClinic e relacao N:N: um usuario pode ter acesso a multiplas
// unidades, com role/permissoes configuradas por unidade.
//
// Patient/CalendarEvent/Quote/Installment NAO ganham clinic_id nesta fase
// (refator gigante). Esta fase entrega cadastro + ranking comparativo
// agregado via tenant_id (cada Clinic pode ser tag para futura migration).

model Clinic {
  id                       String  @id @default(uuid())
  tenant_id                String
  name                     String
  short_name               String? // "Centro SP", "Moema", "Copacabana RJ"
  address                  String?
  city                     String?
  state                    String? // UF
  phone                    String?
  email                    String?
  cnpj                     String?
  // Tipo (Clinicorp distingue dental vs aesthetic)
  type                     String  @default("MIXED") // DENTAL | AESTHETIC | MIXED
  // Horario de funcionamento (JSON por dia da semana)
  working_hours            Json?
  // Logo / branding
  logo_url                 String?
  brand_color              String? // Hex (ex: #F58220)
  // Status
  active                   Boolean @default(true)
  // Para franquias
  is_franchise             Boolean @default(false)
  franchisee_owner_user_id String? // Dono da franquia (se franquia)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_clinics UserClinic[]

  @@unique([tenant_id, name])
  @@index([tenant_id, active])
  @@index([is_franchise])
}

/// Relacao N:N entre User e Clinic com role/permissoes opcionais.
/// Quando um User nao tem registros UserClinic, tem acesso a TODAS as
/// clinicas do tenant (default backward-compatible).
model UserClinic {
  id         String   @id @default(uuid())
  user_id    String
  clinic_id  String
  role       String? // OPERADOR | ADVOGADO | GESTOR | ADMIN | DENTISTA — sobrepoe roles globais nesta unidade
  is_default Boolean  @default(false) // Unidade default ao logar
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinic_id], references: [id], onDelete: Cascade)

  @@unique([user_id, clinic_id])
  @@index([user_id])
  @@index([clinic_id])
}

// ============================================================================
// FASE 16 — SMILE / FACE DESIGN STUDIO (IA de imagem antes/depois)
// ============================================================================
//
// Profissional faz upload de foto do paciente. IA gera simulacao
// antes/depois (sorriso ou harmonizacao facial). Usado como ferramenta
// de venda — aumenta conversao mostrando resultado esperado.
//
// Provider e abstraido: pode ser Replicate, fal.ai, Stability, OpenAI
// gpt-image-1, modelo proprio. Configurado via SettingsService.
// Default: 'mock' (devolve a foto original — placeholder).
//
// CONFORMIDADE CFO Resolucao 118/2012:
//   Toda simulacao deve ser CLARAMENTE rotulada como simulacao,
//   nao garantia. Front-end exibe disclaimer. patient_consent
//   e obrigatorio antes de gerar.

model SmileSimulation {
  id                 String @id @default(uuid())
  tenant_id          String
  patient_id         String
  created_by_user_id String

  simulation_type String // SMILE | FACE_HARMONY | LIPS | RHINOMODULATION | OTHER

  before_s3_key String
  before_url    String?
  after_s3_key  String?
  after_url     String?

  provider          String  @default("mock") // mock | replicate | fal | stability | openai_image | custom
  prompt            String?
  provider_metadata Json?

  status        String  @default("PROCESSING") // PROCESSING | DONE | FAILED
  error_message String?

  patient_consent    Boolean   @default(false)
  patient_consent_at DateTime?

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient    Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  created_by User    @relation("SmileSimulationCreator", fields: [created_by_user_id], references: [id])

  @@index([tenant_id, patient_id])
  @@index([patient_id, created_at])
  @@index([status])
}

// ============================================================================
// FASE 17 — INTEGRACAO RADIOLOGIA (Image2Doc / Proradis / DICOM)
// ============================================================================
//
// Modelo de exames radiograficos recebidos automaticamente de centros
// radiologicos parceiros. O parceiro chama nosso webhook publico
// /webhooks/radiography com:
//   - cpf ou identificador externo do paciente
//   - tipo do exame (PANORAMIC, PERIAPICAL, BITEWING, CT, CBCT)
//   - URL para download da imagem (ou base64 inline)
//   - laudo opcional
// Validacao por X-Radiography-Provider-Key (chave configurada por provider).
//
// Provider tracking:
//   - source = nome do provider (image2doc, proradis, manual, etc.)
//   - source_external_id = ID do exame no sistema do provider (idempotencia)
//
// Integracao DICOM e overlay para o futuro — esta fase trabalha com
// imagens JPG/PNG renderizadas pelo provider, nao DICOM raw.

/// Provider de radiologia configurado (Image2Doc, Proradis etc).
/// Cada provider tem sua chave secreta (api_key_hash) usada no header
/// X-Radiography-Provider-Key para autenticar o webhook.
model RadiographyProvider {
  id               String    @id @default(uuid())
  tenant_id        String
  name             String // 'Image2Doc' | 'Proradis' | etc
  source_slug      String // 'image2doc' | 'proradis' (lowercase, para webhook)
  api_key_hash     String // bcrypt/argon2 da chave secreta
  active           Boolean   @default(true)
  webhook_count    Int       @default(0)
  last_received_at DateTime?
  notes            String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  tenant Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  exams  RadiographyExam[]

  @@unique([tenant_id, source_slug])
  @@index([tenant_id, active])
}

model RadiographyExam {
  id         String  @id @default(uuid())
  tenant_id  String
  patient_id String? // null se nao conseguimos casar com paciente (fica em backlog)

  // Identificacao do parceiro
  provider_id        String?
  source             String // image2doc | proradis | manual | other
  source_external_id String? // ID no sistema do parceiro (idempotencia)

  // Tipo do exame
  exam_type String // PANORAMIC | PERIAPICAL | BITEWING | OCCLUSAL | LATERAL | PA | CT | CBCT | OTHER
  tooth_fdi String? // Dente especifico (para periapical/bitewing)

  // Imagem
  image_s3_key     String
  thumbnail_s3_key String?
  mime_type        String  @default("image/jpeg")

  // Laudo
  report_text String? // Texto livre do radiologista
  report_html String? // HTML rico se vier

  // Datas
  performed_at DateTime? // Data em que o exame foi feito
  received_at  DateTime  @default(now())

  // Status / triagem
  status            String    @default("RECEIVED") // RECEIVED | LINKED | DISCARDED
  linked_at         DateTime? // Quando foi associado a um paciente
  linked_by_user_id String?

  // Match heuristico (CPF, nome, telefone do parceiro para casar com Patient)
  external_patient_cpf  String?
  external_patient_name String?

  // Observacoes da clinica
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  patient   Patient?             @relation(fields: [patient_id], references: [id], onDelete: SetNull)
  provider  RadiographyProvider? @relation(fields: [provider_id], references: [id], onDelete: SetNull)
  linked_by User?                @relation("RadiographyLinker", fields: [linked_by_user_id], references: [id], onDelete: SetNull)

  @@unique([source, source_external_id])
  @@index([tenant_id, patient_id])
  @@index([patient_id, performed_at])
  @@index([status, received_at])
  @@index([external_patient_cpf])
}
